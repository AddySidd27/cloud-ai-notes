---
layout: base.njk
pagination:
  data: collections.liveTopics
  size: 1
  alias: topic
permalink: "/{{ topic.slug }}/"
eleventyComputed:
  title: "{{ topic.name }}"
  deck: "{{ topic.blurb }}"
---
{%- set tseries = [] -%}
{%- for s in collections.liveSeries %}{% if s.category == topic.slug %}{% set tseries = (tseries.push(s), tseries) %}{% endif %}{% endfor %}
{%- if topic.slug == "labs" %}{% set tseries = tseries | reverse %}{% endif %}
{%- set lpName = topic.name -%}
{%- set lpMid = none -%}
{%- set lpTitle = topic.name -%}
{%- set lpLead = topic.blurb -%}
{%- if tseries.length > 1 -%}
{%- set lpCount = topic.posts.length + " articles in " + tseries.length + " series. Do the Azure basics labs first. The Terraform labs build on them." -%}
{%- else -%}
{%- set lpCount = topic.posts.length + " articles, in reading order." -%}
{%- endif -%}
{%- set lpGroups = tseries -%}
{%- set lpShowSeries = false -%}
{% include "landing.njk" %}
