" height="21" as="geometry"/></mxCell><mxCell id="c79" value="In the reference architecture, Policy is assigned at the" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="530.32" y="712.3" width="429.36" height="19.6" as="geometry"/></mxCell><mxCell id="c80" value="management group, so landing zone administrators with roles" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="518.98" y="732.3" width="452.04" height="19.6" as="geometry"/></mxCell><mxCell id="c81" value="at a lower scope cannot change the policies that govern them." style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="511.42" y="752.3" width="467.16" height="19.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>