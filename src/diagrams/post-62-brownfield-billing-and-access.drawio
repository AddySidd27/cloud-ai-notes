yle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="43" y="610.1" width="287.88" height="25.2" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="649" width="8" height="8" as="geometry"/></mxCell><mxCell id="c49" value="Billing roles decide who creates subscriptions and who sees cost. They go to individual users." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="646.2" width="818.16" height="22.4" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="681" width="8" height="8" as="geometry"/></mxCell><mxCell id="c51" value="Azure roles and policy decide what happens inside. Management groups pass them down." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="678.2" width="731.76" height="22.4" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="713" width="8" height="8" as="geometry"/></mxCell><mxCell id="c53" value="Account owners and department admins see prices only with both: view charges on, and the Owner role." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="710.2" width="870" height="22.4" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="745" width="8" height="8" as="geometry"/></mxCell><mxCell id="c55" value="So a finance contact and a subscription Owner are different people with different tools." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="742.2" width="766.32" height="22.4" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>