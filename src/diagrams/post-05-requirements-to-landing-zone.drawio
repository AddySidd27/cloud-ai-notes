"targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="Before you build the platform landing zone, define your organizational requirements" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="160.02" y="631.3" width="679.96" height="19.6" as="geometry"/></mxCell><mxCell id="c64" value="across the design areas. These decisions shape the design." style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="261.52" y="650.3" width="476.96" height="19.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>