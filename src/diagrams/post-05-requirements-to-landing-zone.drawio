ntColor=#3a3a3a;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="406" y="161.3" width="315.96" height="19.6" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=8.16;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3b6fb6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="590" height="98" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="404" y="209" width="28" height="28" as="geometry"/></mxCell><mxCell id="c34" value="Azure Policy" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=15;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="442" y="210.25" width="110.4" height="21" as="geometry"/></mxCell><mxCell id="c35" value="Map compliance rules to policy definitions." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#3a3a3a;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="406" y="235.3" width="331.08" height="19.6" as="geometry"/></mxCell><mxCell id="c36" value="An allowed locations policy enforces region rules." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#3a3a3a;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="406" y="252.3" width="384" height="19.6" as="geometry"/></mxCell><mxCell id="c37" value="Put these rules in the baseline from the start." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#3a3a3a;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="