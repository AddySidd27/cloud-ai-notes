Style=1;fontColor=#ffffff;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="655.36" y="524.2" width="15.28" height="22.4" as="geometry"/></mxCell><mxCell id="c83" value="" style="edgeStyle=none;html=1;strokeColor=#3a3a3a;strokeWidth=2.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="243" y="425" as="sourcePoint"/><mxPoint x="243" y="637" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c84" value="" style="edgeStyle=none;html=1;strokeColor=#3a3a3a;strokeWidth=2.5;endArrow=classic;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="243" y="637" as="sourcePoint"/><mxPoint x="359" y="637" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c85" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="287" y="623" width="28" height="28" as="geometry"/></mxCell><mxCell id="c86" value="3" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="293.36" y="626.2" width="15.28" height="22.4" as="geometry"/></mxCell><mxCell id="c87" value="" style="rounded=1;arcSize=6.49;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8f98;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="23" y="793" width="960" height="154" as="geometry"/></mxCell><mxCell id="c88" value="Read the arrows in this order" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=18;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="43" y="802.1" width="308.76" height="25.2" as="geometry"/></mxCell><mxCell id="c89" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="838" width="28" height="28" as="geometry"/></mxCell><mxCell id="c90" value="1" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="49.36" y="841.2" width="15.28" height="22.4" as="geometry"/></mxCell><mxCell id="c91" value="New subscriptions that hold migrated workloads go into the duplicates (confirm for existing ones). They only audit." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="840.2" width="999.6" height="22.4" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="874" width="28" height="28" as="geometry"/></mxCell><mxCell id="c93" value="2" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="49.36" y="877.2" width="15.28" height="22.4" as="geometry"/></mxCell><mxCell id="c94" value="When a team&#x27;s policy compliance is in the required state, its subscription moves to the matching group." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="876.2" width="895.92" height="22.4" as="geometry"/></mxCell><mxCell id="c95" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="910" width="28" height="28" as="geometry"/></mxCell><mxCell id="c96" value="3" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="49.36" y="913.2" width="15.28" height="22.4" as="geometry"/></mxCell><mxCell id="c97" value="Eventually, cancel the old subscription and place it in the Decommissioned group." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="912.2" width="705.84" height="22.4" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>