.6" as="geometry"/></mxCell><mxCell id="c31" value="Something you are (fingerprint)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="539.3" width="240.36" height="19.6" as="geometry"/></mxCell><mxCell id="c32" value="Three built-in strengths" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="479.3" width="200.88" height="19.6" as="geometry"/></mxCell><mxCell id="c33" value="Multifactor (less restrictive)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="499.3" width="232.8" height="19.6" as="geometry"/></mxCell><mxCell id="c34" value="Passwordless MFA (no password)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="519.3" width="232.8" height="19.6" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;arcSize=15.38;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#3c8d40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="350" y="546" width="292" height="26" as="geometry"/></mxCell><mxCell id="c36" value="Phishing-resistant (most restrictive)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"