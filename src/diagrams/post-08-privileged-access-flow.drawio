></mxCell><mxCell id="c43" value="Role is eligible," style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="691.3" width="144.04" height="19.6" as="geometry"/></mxCell><mxCell id="c44" value="not always active" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="711.3" width="134.52" height="19.6" as="geometry"/></mxCell><mxCell id="c45" value="To activate:" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="691.3" width="103.44" height="19.6" as="geometry"/></mxCell><mxCell id="c46" value="MFA check" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="711.3" width="74.04" height="19.6" as="geometry"/></mxCell><mxCell id="c47" value="A business reason" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="731.3" width="134.52" height="19.6" as="geometry"/></mxCell><mxCell id="c48" value="Approval, if required" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="751.3" width="164.76" height="19.6" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=none;html=1;strokeColor=#3a3a3a;strokeWidth=2;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="790" as="sourcePoint"/><mxPoint x="500" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=5.66;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3b6fb6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="818" width="940" height="106" as="geometry"/></mxCell><mxCell id="c51" value="Role active, then it ends" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=15;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="832.25" width="223.5" height="21" as="geometry"/></mxCell><mxCell id="c52" value="Works for a set time only" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="865.3" width="195" height="19.6" as="geometry"/></mxCell><mxCell id="c53" value="Notifications, audit history and access reviews" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="887.3" width="361.32" height="19.6" as="geometry"/></mxCell><mxCell id="c54" value="Safety net" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#3a3a3a;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="456.4" y="939.3" width="87.2" height="19.6" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff7e0;strokeColor=#8a6d00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="970" width="940" height="150" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="46" y="980" width="28" height="28" as="geometry"/></mxCell><mxCell id="c57" value="Emergency access (break-glass) accounts" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="986.3" width="322.68" height="19.6" as="geometry"/></mxCell><mxCell id="c58" value="Two or more, cloud-only (*.onmicrosoft.com)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1019.3" width="331.08" height="19.6" as="geometry"/></mxCell><mxCell id="c59" value="Passkey (FIDO2), different from normal admins" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1039.3" width="346.2" height="19.6" as="geometry"/></mxCell><mxCell id="c60" value="Global Administrator, permanent active in PIM" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1059.3" width="346.2" height="19.6" as="geometry"/></mxCell><mxCell id="c61" value="Excluded from Conditional Access policies that block or restrict sign-in" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1079.3" width="550.32" height="19.6" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=1;arcSize=4.62;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1136" width="940" height="130" as="geometry"/></mxCell><mxCell id="c63" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="46" y="1146" width="28" height="28" as="geometry"/></mxCell><mxCell id="c64" value="Monitor and test the emergency accounts" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="1152.3" width="322.68" height="19.6" as="geometry"/></mxCell><mxCell id="c65" value="Alert on every sign-in (Log Analytics or Microsoft Sentinel)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1185.3" width="459.6" height="19.6" as="geometry"/></mxCell><mxCell id="c66" value="Test that they work at least every 90 days" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1205.3" width="323.52" height="19.6" as="geometry"/></mxCell><mxCell id="c67" value="Review after any use: drill, emergency or misuse" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1225.3" width="368.88" height="19.6" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=1;arcSize=11.11;whiteSpace=wrap;html=1;fillColor=#fff7e0;strokeColor=#8a6d00;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="1282" width="940" height="54" as="geometry"/></mxCell><mxCell id="c69" value="Before turning a policy On: administrators must have registered their sign-in methods," style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="147.84" y="1289.3" width="704.32" height="19.6" as="geometry"/></mxCell><mxCell id="c70" value="or you risk locking yourself out." style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="363.02" y="1309.3" width="273.96" height="19.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>