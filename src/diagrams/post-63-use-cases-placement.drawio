=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=18;fontStyle=1;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="43" y="550.1" width="152.16" height="25.2" as="geometry"/></mxCell><mxCell id="c63" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="591" width="8" height="8" as="geometry"/></mxCell><mxCell id="c64" value="Ask where the workload connects: the hub means Corp, the internet means Online, Azure Local means Local." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="586.2" width="904.56" height="22.4" as="geometry"/></mxCell><mxCell id="c65" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="621" width="8" height="8" as="geometry"/></mxCell><mxCell id="c66" value="Add an extra group under Landing zones only for a subset of workloads with a real extra rule." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="616.2" width="809.52" height="22.4" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="651" width="8" height="8" as="geometry"/></mxCell><mxCell id="c68" value="Development, test and production are subscriptions in the same group. They are not groups." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="646.2" width="783.6" height="22.4" as="geometry"/></mxCell><mxCell id="c69" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="681" width="8" height="8" as="geometry"/></mxCell><mxCell id="c70" value="Platform subscriptions hold shared services. Workloads do not go there." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="676.2" width="619.44" height="22.4" as="geometry"/></mxCell><mxCell id="c71" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=#1f2933;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="43" y="711" width="8" height="8" as="geometry"/></mxCell><mxCell id="c72" value="A new subscription goes where its policies should apply, not where its team sits on the org chart." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=16;fontStyle=0;fontColor=#1f2933;fontFamily=Segoe UI;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="63" y="706.2" width="852.72" height="22.4" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>