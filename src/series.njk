---
layout: base.njk
pagination:
  data: collections.liveSeries
  size: 1
  alias: ser
permalink: "/{{ ser.slug }}/"
eleventyComputed:
  title: "{{ ser.title }}"
  deck: "{{ ser.blurb }}"
---
{%- set tp = ser | topicOf -%}
{%- set list = ser.posts -%}
<header class="band"><div class="wrap band-in">
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{% if tp.name != ser.name %}<li><a href="/{{ tp.slug }}/">{{ tp.name }}</a></li>{% endif %}<li aria-current="page">{{ ser.name }}</li></ol></nav>
  <h1>{{ ser.title }}</h1>
  <p class="lead">{{ ser.blurb }}</p>
  <p class="cta"><a class="btn" href="{{ list[0].url }}">Start with the first article</a></p>
  {%- if ser.tag == "alz" %}<p class="side-note">New to landing zones? <a href="/start-here/">Read the introduction first</a>.</p>{% endif %}
</div></header>
<div class="wrap sec">
  <ol class="alist numbered">
    {%- for p in list %}{% include "row.njk" %}{% endfor %}
  </ol>
</div>
