---
layout: base.njk
pagination:
  data: collections.liveSeries
  size: 1
  alias: ser
permalink: "/{{ ser.slug }}/"
eleventyComputed:
  title: "{{ ser.title }}"
  deck: "{{ ser.blurb }}"
---
{%- set tp = ser | topicOf -%}
{%- set lpName = ser.name -%}
{%- set lpMid = tp if tp.name != ser.name else none -%}
{%- set lpTitle = ser.title -%}
{%- set lpLead = ser.blurb -%}
{%- set lpCount = ser.posts.length + " articles, in reading order." -%}
{%- set lpGroups = [ser] -%}
{%- set lpShowSeries = false -%}
{% include "landing.njk" %}
