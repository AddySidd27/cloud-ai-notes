<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and not home %}{{ title }} | {% endif %}{{ site.name }}{% if home %}: {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ (deck or site.description) | striptags | truncate(190) }}">
<link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{% if home %}website{% else %}article{% endif %}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ (deck or site.description) | striptags | truncate(190) }}">
<meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
<meta property="og:image" content="{{ '/img/og.png' | absUrl(site.url) }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0A1B33">
<link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="masthead"><div class="wrap">
  <a class="brand" href="/" aria-label="{{ site.name }}, home">{% include "mark.njk" %}<span>{{ site.name }}</span></a>
  <nav class="nav" aria-label="Main">
    <a href="/#topics">Topics</a>
    <a href="/start-here/"{% if page.url == '/start-here/' %} aria-current="page"{% endif %}>Start here</a>
    <a href="{{ site.repo }}">GitHub</a>
    <button class="theme" type="button" aria-label="Switch between light and dark theme">Dark theme</button>
  </nav>
</div></header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot"><div class="wrap">
  <div class="foot-top">
    <a class="brand" href="/">{% include "mark.njk" %}<span>{{ site.name }}</span></a>
    <nav aria-label="Footer"><a href="/start-here/">Start here</a>{% for t in topics %}<a href="/{{ t.slug }}/">{{ t.name }}</a>{% endfor %}<a href="{{ site.repo }}">GitHub</a></nav>
  </div>
  <p>{{ site.name }} is written by {{ site.author }}. This is an independent site and is not published by or affiliated with Microsoft. Azure facts are checked against Microsoft Learn. Diagrams are simplified redraws that use Microsoft's official Azure and Microsoft Entra icons under Microsoft's icon terms, and each one names the Learn page it follows.</p>
</div></footer>
<script src="/js/site.js" defer></script>
</body>
</html>
