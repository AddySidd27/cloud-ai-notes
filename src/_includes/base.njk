<!doctype html>
{%- set isArticle = (order and order > 0) -%}
{%- set slugPart = page.url.split('/')[1] if page.url == '/start-here/' else page.url.split('/')[2] -%}
{%- set ogPath = ('/img/og/' + slugPart + '.png') if (isArticle or page.url == '/start-here/') else '/img/og/default.png' -%}
{%- set desc = (deck or site.description) | striptags | truncate(190) -%}
{%- set canon = page.url | absUrl(site.url) -%}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and not home %}{{ title }} | {% endif %}{{ site.name }}{% if home %}: {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canon }}">
<meta name="author" content="{{ site.author }}">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canon }}">
<meta property="og:image" content="{{ ogPath | absUrl(site.url) }}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title or site.name }}, {{ site.name }}">
{%- if isArticle %}
<meta property="article:published_time" content="{{ articleMeta[order].published }}">
<meta property="article:author" content="{{ site.author }}">
{%- for t in articleMeta[order].tags %}<meta property="article:tag" content="{{ t }}">{% endfor %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ ogPath | absUrl(site.url) }}">
<meta name="theme-color" content="#0A1B33">
<link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
<script>try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
{%- if home %}
<script type="application/ld+json">{{ site | ldHome | safe }}</script>
{%- endif %}
{%- if isArticle %}
{%- set ser = tags | seriesOf %}{% set tp = ser | topicOf %}
<script type="application/ld+json">{{ { site: site, title: title, deck: deck, url: canon, img: (ogPath | absUrl(site.url)), meta: articleMeta[order], ser: ser, tp: tp } | ldArticle | safe }}</script>
{%- endif %}
</head>
<body{% if isArticle %} class="is-article"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{%- if isArticle %}<div class="progress" aria-hidden="true"><i></i></div>{% endif %}
<header class="masthead"><div class="wrap mast-in">
  {% include "brand.njk" %}
  <div class="tools">
    <a class="icon-btn" href="/search/" aria-label="Search articles"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg></a>
    <button class="icon-btn" id="theme" type="button" aria-label="Switch colour theme" aria-pressed="false"><svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg><svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </div>
  <nav class="nav" aria-label="Main">
    <a href="/azure-landing-zone/"{% if page.url == '/azure-landing-zone/' %} aria-current="page"{% endif %}>Landing Zones</a>
    <a href="/articles/"{% if page.url == '/articles/' %} aria-current="page"{% endif %}>All Articles</a>
    <a href="/labs/"{% if page.url == '/labs/' %} aria-current="page"{% endif %}>Labs &amp; Code</a>
    <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
  </nav>
</div></header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot"><div class="wrap">
  <div class="foot-grid">
    <div class="foot-brand">
      {% include "brand.njk" %}
      <p>{{ site.tagline }}</p>
    </div>
    <nav aria-label="Read"><h2>Read</h2><a href="/articles/">All articles</a><a href="/start-here/">Start here</a>{% for s in collections.liveSeries %}<a href="/{{ s.slug }}/">{{ s.name }} series</a>{% endfor %}<a href="/search/">Search</a></nav>
    <nav aria-label="Topics"><h2>Topics</h2>{% for t in collections.liveTopics %}<a href="/{{ t.slug }}/">{{ t.name }}</a>{% endfor %}<a href="/labs/">Labs</a></nav>
    <nav aria-label="Site"><h2>Site</h2><a href="/about/">About</a><a href="{{ site.repo }}">GitHub</a><a href="/feed.xml">RSS feed</a></nav>
  </div>
  <p class="copy">&copy; {{ site.year }} {{ site.author }}. Personal blog, opinions are my own. Not affiliated with Microsoft.</p>
</div></footer>
<script src="/js/site.js" defer></script>
</body>
</html>
