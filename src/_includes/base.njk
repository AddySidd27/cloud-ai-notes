<!doctype html>
{%- set isArticle = (order and order > 0) -%}
{%- set slugPart = page.url.split('/')[1] if page.url == '/start-here/' else page.url.split('/')[2] -%}
{%- set ogPath = ('/img/og/' + slugPart + '.png') if (isArticle or page.url == '/start-here/') else '/img/og/default.png' -%}
{%- set desc = (description or deck or site.description) | striptags | truncate(190) -%}
{%- set canon = page.url | absUrl(site.url) -%}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and not home %}{{ seoTitle or title }} | {% endif %}{{ site.name }}{% if home %}: {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canon }}">
<meta name="author" content="{{ site.author }}">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canon }}">
<meta property="og:image" content="{{ ogPath | absUrl(site.url) }}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title or site.name }}, {{ site.name }}">
{%- if isArticle %}
<meta property="article:published_time" content="{{ articleMeta[order].published }}">
<meta property="article:author" content="{{ site.author }}">
{%- for t in articleMeta[order].tags %}<meta property="article:tag" content="{{ t }}">{% endfor %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ ogPath | absUrl(site.url) }}">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)">
<link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css?v=20261115-p5">
{%- if interactive %}
<link rel="stylesheet" href="/css/interactive.css?v=20261115-p5">
{%- endif %}
{%- if home %}
<script type="application/ld+json">{{ site | ldHome | safe }}</script>
{%- endif %}
{%- if isArticle %}
{%- set ser = tags | seriesOf %}{% set tp = ser | topicOf %}
<script type="application/ld+json">{{ { site: site, title: title, deck: (description or deck), url: canon, img: (ogPath | absUrl(site.url)), meta: articleMeta[order], ser: ser, tp: tp } | ldArticle | safe }}</script>
{%- endif %}
</head>
<body{% if isArticle %} class="is-article"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="masthead"><div class="wrap mast-in">
  {% include "brand.njk" %}
  <nav class="nav" aria-label="Main">
    <a href="/articles/"{% if page.url == '/articles/' %} aria-current="page"{% endif %}>Articles</a>
    <a href="/azure-landing-zone/"{% if page.url == '/azure-landing-zone/' %} aria-current="page"{% endif %}>Landing Zones</a>
    <a href="/azure-virtual-desktop/"{% if page.url == '/azure-virtual-desktop/' %} aria-current="page"{% endif %}>AVD</a>
    <a href="/windows-365-enterprise/"{% if page.url == '/windows-365-enterprise/' %} aria-current="page"{% endif %}>Windows 365</a>
    <a href="/labs/"{% if page.url == '/labs/' %} aria-current="page"{% endif %}>Labs</a>
    <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
  </nav>
  <div class="tools">
    <a class="search-link" href="/search/" aria-label="Search articles"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span>Search</span></a>
  </div>
</div></header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot"><div class="wrap foot-in">
  <div class="foot-id">
    <a class="brand" href="/" aria-label="Adnan Ahmed Siddiqui, home"><img class="brand-mark" src="/img/logo/mark.svg" width="30" height="30" alt=""><span class="wordmark" aria-hidden="true"><span class="wm-a">Adnan</span><span class="wm-b">Ahmed</span><span class="wm-c">Siddiqui</span></span></a>
  </div>
  <nav class="foot-links" aria-label="Footer">
    <a href="/articles/">Articles</a><a href="/labs/">Labs</a><a href="/about/">About</a>
  </nav>
  <nav class="foot-links foot-ext" aria-label="Elsewhere">
    <a href="{{ site.linkedin }}" rel="me noopener">LinkedIn</a><a href="{{ site.repo }}">GitHub</a><a href="/feed.xml">RSS</a>
  </nav>
  <p class="copy">&copy; {{ site.year }} {{ site.author }}</p>
</div></footer>
<script src="/js/site.js?v=20261115-p5" defer></script>
{%- if interactive %}
<script src="/js/interactive.js?v=20261115-p5" defer></script>
{%- endif %}
</body>
</html>
