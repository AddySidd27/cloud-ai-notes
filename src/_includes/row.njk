{# expects: p (article page). optional: ser (series), showSeries #}
{%- set rmeta = articleMeta[p.data.order] -%}
<li><a href="{{ p.url }}">
  <strong>{{ p.data.title }}</strong>
  <span class="ad">{{ p.data.deck | clip(240) }}</span>
  <span class="am">{% if showSeries %}<span>{{ ser.name }}</span>{% endif %}{% if rmeta %}<time datetime="{{ rmeta.published }}">{{ rmeta.published | longDate }}</time>{% endif %}<span>{{ p.templateContent | readingTime }} min read</span></span>
</a></li>
