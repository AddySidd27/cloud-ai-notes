15" value="&lt;b&gt;Compute Engine VM&lt;/b&gt;&lt;br&gt;&lt;b&gt;OS Login on&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1017" y="72" width="204" height="42" as="geometry"/></mxCell><mxCell id="c16" value="No external IP address&lt;br&gt;needed for IAP TCP forwarding&lt;br&gt;&lt;br&gt;Cannot use metadata-based&lt;br&gt;SSH keys (stored in project&lt;br&gt;or instance metadata)" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="973" y="126" width="242" height="122" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;" vertex="1" parent="1"><mxGeometry x="283" y="360" width="320" height="250" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="297" y="372" width="32" height="32" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;IAM role&lt;/b&gt;&lt;br&gt;&lt;b&gt;IAP-secured Tunnel User&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="341" y="372" width="254" height="42" as="geometry"/></mxCell><mxCell id="c20" value="roles/iap.tunnelResourceAccessor&lt;br&gt;&lt;br&gt;Granted to a user or group&lt;br&gt;on the project, or on one VM" style="text;html=1;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="297" y="426" width="292" height="82" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;" vertex="1" parent="1"><mxGeometry x="959" y="360" width="270" height="250" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;aspec