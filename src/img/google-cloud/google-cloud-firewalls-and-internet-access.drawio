<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="google-cloud-firewalls-and-internet-access" name="google-cloud-firewalls-and-internet-access"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="910" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1248" height="898" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="520" height="862" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Example: two rules in a network firewall policy&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="34" width="480" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;instance-1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;service=frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="44" y="76" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="93.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;instance-2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;service=backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="334" y="76" width="190" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="348" y="93.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;instance-3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;only Rule 1 matches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="294" y="190" width="230" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="308" y="207.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#3f8f55;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="Rule 2: allow" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="236" y="80" width="96" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#c9792a;strokeWidth=2;dashed=1;dashPattern=7 5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139" y="222"/></Array></mxGeometry></mxCell><mxCell id="c13" value="Rule 1: deny" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="150" y="194" width="130" height="24" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Rule 2: ingress allow, priority 999&lt;/font&gt;&lt;/b&gt;&lt;br&gt;From tag service=frontend to tag service=backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fbf8e;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="44" y="276" width="480" height="64" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="293.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Rule 1: egress deny, priority 65530&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Outbound traffic from all sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0a96b;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="44" y="354" width="480" height="64" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="371.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c18" value="Rule 2 allows frontend to backend." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="424" width="480" height="24" as="geometry"/></mxCell><mxCell id="c19" value="Only Rule 1 matches traffic to instance-3." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="446" width="480" height="24" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Default order for each VPC network&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="486" width="480" height="24" as="geometry"/></mxCell><mxCell id="c21" value="A network setting can move steps 4 and 5 before step 3." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="510" width="480" height="24" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;1. Hierarchical firewall policies&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Organization first, then folders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="544" width="480" height="52" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;2. Regional system firewall policies&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Evaluated right after hierarchical policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="604" width="480" height="52" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;3. VPC firewall rules&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The blueprint does not use these" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="664" width="480" height="52" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;4. Global network firewall policy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="724" width="480" height="36" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;5. Regional network firewall policies&lt;/font&gt;&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="768" width="480" height="36" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;6. Implied action&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ingress to a VM: deny. Egress: allow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="812" width="480" height="52" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="564" y="24" width="672" height="862" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Internet access and Google services in the blueprint&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="34" width="632" height="24" as="geometry"/></mxCell><mxCell id="c30" value="The blueprint allows no inbound or outbound traffic between its VPC networks" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="60" width="632" height="24" as="geometry"/></mxCell><mxCell id="c31" value="and the internet. For workloads that need it, the blueprint recommends the options below." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="80" width="632" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Outbound to the internet&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="118" width="632" height="24" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;VM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;sends traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="584" y="148" width="170" height="70" as="geometry"/></mxCell><mxCell id="c34" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="598" y="168.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Cloud NAT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;recommended" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="794" y="148" width="230" height="70" as="geometry"/></mxCell><mxCell id="c36" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="808" y="168.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Internet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1064" y="148" width="152" height="70" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="For finer control, Secure Web Proxy allows only trusted web services." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="224" width="632" height="24" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Inbound from the internet&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="268" width="632" height="24" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Internet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="584" y="298" width="150" height="70" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Cloud Load Balancing&lt;/font&gt;&lt;/b&gt;&lt;br&gt;with Google Cloud Armor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="774" y="298" width="260" height="70" as="geometry"/></mxCell><mxCell id="c44" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="788" y="318.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;VM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="1074" y="298" width="142" height="70" as="geometry"/></mxCell><mxCell id="c46" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1088" y="318.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Not recommended&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Direct connectivity between the internet and a VM through an external IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0a96b;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="584" y="384" width="632" height="58" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Google Cloud services&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="462" width="632" height="24" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;VM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;in a subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="584" y="492" width="170" height="70" as="geometry"/></mxCell><mxCell id="c52" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="598" y="512.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Private Service Connect&lt;/font&gt;&lt;/b&gt;&lt;br&gt;endpoint, TCP 443 allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="794" y="492" width="262" height="70" as="geometry"/></mxCell><mxCell id="c54" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="808" y="512.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Google Cloud&lt;/font&gt;&lt;/b&gt;&lt;br&gt;services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1084" y="492" width="132" height="70" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="Private Google Access is on for every subnet." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="568" width="632" height="24" as="geometry"/></mxCell><mxCell id="c59" value="Firewall policies and DNS records allow traffic to the endpoint." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="588" width="632" height="24" as="geometry"/></mxCell><mxCell id="c60" value="Used together, these controls allow a private path to Google Cloud services," style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="608" width="632" height="24" as="geometry"/></mxCell><mxCell id="c61" value="without relying on internet outbound traffic." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="628" width="632" height="24" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Hierarchical firewall policy rules in the blueprint&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="662" width="632" height="24" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Examples from the blueprint&lt;/font&gt;&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fbf8e;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="584" y="692" width="632" height="184" as="geometry"/></mxCell><mxCell id="c64" value="Ingress allow TCP ports 22, 3389 from 35.235.240.0/20: IAP for TCP forwarding" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="736" width="632" height="24" as="geometry"/></mxCell><mxCell id="c65" value="Ingress allow TCP ports 80, 443 from four Google ranges: health checks" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="762" width="632" height="24" as="geometry"/></mxCell><mxCell id="c66" value="Egress allow TCP port 1688 to 35.190.247.13/32: Windows server activation" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="788" width="632" height="24" as="geometry"/></mxCell><mxCell id="c67" value="Private address ranges (RFC 1918), in and out: go to next" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="814" width="632" height="24" as="geometry"/></mxCell><mxCell id="c68" value="Go to next: continues with the next folder policy, or the next step" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="584" y="840" width="632" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>