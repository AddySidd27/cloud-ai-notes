<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="windows-365-daily-operations" name="windows-365-daily-operations"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1288" height="648" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1240" height="140" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Before users notice a problem (Windows 365 Enterprise)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="38" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Intune Remediations&lt;/b&gt;&lt;br&gt;Script packages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="50" y="76" width="400" height="76" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="64" y="99.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cloud PCs&lt;/b&gt;&lt;br&gt;Windows 365 Enterprise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="800" y="76" width="320" height="76" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="814" y="99.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="detect and fix common support issues" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="480" y="84" width="300" height="24" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="1240" height="300" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;When a problem is reported: work in order and stop when it is solved. Each step is more disruptive than the one before.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="198" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;1. Triage&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Alert, Admin Insights item&lt;br&gt;or user report: triage&lt;br&gt;severity and find the&lt;br&gt;affected Cloud PCs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="240" width="218" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;2. Users cannot connect&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Describe the issue to&lt;br&gt;Windows 365 admin assistant&lt;br&gt;(preview). Run Troubleshoot,&lt;br&gt;review the health checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="293" y="240" width="218" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;3. Cloud PCs are slow&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Check the Resource&lt;br&gt;performance report. If&lt;br&gt;constrained, use Resize&lt;br&gt;(Enterprise)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="541" y="240" width="218" height="150" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;4. The issue persists&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Create a manual restore&lt;br&gt;point, then restore to a&lt;br&gt;known-good restore point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="789" y="240" width="218" height="150" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;5. Not solved by 1 to 4&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Reprovision the Cloud PC.&lt;br&gt;Last resort." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1037" y="240" width="218" height="150" as="geometry"/></mxCell><mxCell id="c17" value="Data impact: None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf3;strokeColor=#8cc08c;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="410" width="218" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Data impact: None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf3;strokeColor=#8cc08c;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="293" y="410" width="218" height="60" as="geometry"/></mxCell><mxCell id="c19" value="Data impact: None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf3;strokeColor=#8cc08c;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="541" y="410" width="218" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Changes after the selected&lt;br&gt;restore point are lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#d9a09a;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="789" y="410" width="218" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Enterprise: all user data,&lt;br&gt;apps and settings deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#d9a09a;fontSize=14;fontColor=#1f2933;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1037" y="410" width="218" height="60" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="1240" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Bulk remote actions&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="518" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c28" value="Most remote actions support bulk, including Restart, Restore, Resize, Reprovision and Troubleshoot." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="552" width="1180" height="24" as="geometry"/></mxCell><mxCell id="c29" value="Bulk actions support up to 5,000 Cloud PCs per operation, except where noted. Rename and Update Windows Defender do not support bulk." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="580" width="1180" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>