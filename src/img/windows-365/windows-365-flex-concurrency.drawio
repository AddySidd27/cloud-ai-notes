<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="windows-365-flex-concurrency" name="windows-365-flex-concurrency"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="748" height="1098" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="700" height="670" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;The limit, the concurrency buffer and the blocks&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="38" width="660" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Maximum concurrency limit&lt;/b&gt;&lt;br&gt;Set by the Flex licenses you bought&lt;br&gt;(per Cloud PC license size)&lt;br&gt;At the limit, others cannot connect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="320" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Concurrency buffer&lt;/b&gt;&lt;br&gt;Used when over the limit&lt;br&gt;Dedicated mode only&lt;br&gt;Not for Shared mode&lt;br&gt;Not for GPU-enabled Cloud PCs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="80" width="320" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Buffer limits&lt;/b&gt;&lt;br&gt;Up to four times per day&lt;br&gt;Up to one hour each time&lt;br&gt;The hour starts when the limit is exceeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="660" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Temporary block of the buffer&lt;/b&gt;&lt;br&gt;48 hours. Caused by using the&lt;br&gt;buffer for more than one hour,&lt;br&gt;four or more times in 24 hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Permanent block of the buffer&lt;/b&gt;&lt;br&gt;Temporarily blocked more than&lt;br&gt;two times in a seven day period&lt;br&gt;Unblock: open a ticket with support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;While blocked, you can still use Flex Cloud PCs&lt;br&gt;up to the maximum concurrency limit&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="660" height="76" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="62" y="612" width="30" height="30" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7576;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=0.2424;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2424;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7576;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="700" height="350" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Where to see buffer use and license use&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="738" width="660" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Connected Windows 365 Flex&lt;br&gt;Cloud PCs report (preview)&lt;/b&gt;&lt;br&gt;Connections now, limit, 28 days&lt;br&gt;Users now using the buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="320" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Windows 365 Flex&lt;br&gt;connection hourly report&lt;/b&gt;&lt;br&gt;Shows buffer use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="780" width="320" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Windows 365 Flex&lt;br&gt;concurrency alert&lt;/b&gt;&lt;br&gt;An alert each time the buffer&lt;br&gt;is activated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="920" width="320" height="140" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;License and utilization&lt;br&gt;(preview)&lt;/b&gt;&lt;br&gt;Licenses by type and SKU&lt;br&gt;Peak connections, total hours&lt;br&gt;Kept 180 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="920" width="320" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>