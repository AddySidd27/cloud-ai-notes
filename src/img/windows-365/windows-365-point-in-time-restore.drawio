: data in external services,&lt;br&gt;such as OneDrive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=45;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="270" height="190" as="geometry"/></mxCell><mxCell id="c42" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="898.0" y="156" width="34" height="34" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="702" y="455" as="sourcePoint"/><mxPoint x="778" y="245" as="targetPoint"/><Array as="points"><mxPoint x="740" y="455"/><mxPoint x="740" y="245"/></Array></mxGeometry></mxCell><mxCell id="c44" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#e6b866;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="270" height="130" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;After the restore&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="794" y="427.0" width="242" height="24" as="geometry"/></mxCell><mxCell id="c46" value="The user signs in to check it." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="794" y="446.0" width="242" height="24" as="geometry"/></mxCell><mxCell id="c47" value="Cannot connect: restore to a" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="794" y="465.0" width="242" height="24" as="geometry"/></mxCell><mxCell id="c48" value="more recent point. Rare: reprovision." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="794" y="484.0" width="242"