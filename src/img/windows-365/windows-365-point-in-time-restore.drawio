36" width="328" height="112" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="68" y="375.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Long-term&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="363.5" width="266" height="24" as="geometry"/></mxCell><mxCell id="c19" value="4 points, made by the service" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="382.5" width="266" height="24" as="geometry"/></mxCell><mxCell id="c20" value="One every 7 days, not changeable" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="401.5" width="266" height="24" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="56" y="464" width="328" height="126" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="68" y="510.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Manual, on demand&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="489.0" width="266" height="24" as="geometry"/></mxCell><mxCell id="c24" value="One per Cloud PC, made by an admin" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="508.0" width="266" height="24" as="geometry"/></mxCell><mxCell id="c25" value="A new one replaces it, or it" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="527.0" width="266" height="24" as="geometry"/></mxCell><mxCell id="c26" value="expires in about 28 days" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="112" y="546.0" width="266" height="24" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="250" height="150" as="geometry"/></mxCell><mxCell id="c28" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="462" y="228.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Choose one point&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="506" y="207.0" width="188" height="24" as="geometry"/></mxCell><mxCell id="c30" value="The closest healthy point." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="506" y="226.0" width="188" height="24" as="geometry"/></mxCell><mxCell id="c31" value="Triangle warning: unhealthy," style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="506" y="245.0" width="188" height="24" as="geometry"/></mxCell><mxCell id="c32" value="lower chance to restore" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="506" y="264.0" width="188" height="24" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="402" y="245" as="sourcePoint"/><mxPoint x="448" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell i