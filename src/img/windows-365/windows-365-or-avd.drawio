<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="windows-365-or-avd" name="windows-365-or-avd"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="912" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="928" height="900" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa5b1;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="355" y="22" width="230" height="50" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="372" y="32" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="72" as="sourcePoint"/><mxPoint x="470" y="114" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="connect through" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="482" y="84" width="300" height="24" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Both use the Azure Virtual Desktop connection services&lt;/b&gt;&lt;br&gt;Gateway, broker and web client services, run by Microsoft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="116" width="880" height="76" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="192" as="sourcePoint"/><mxPoint x="245" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="192" as="sourcePoint"/><mxPoint x="695" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="connect to Cloud PCs" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="257" y="204" width="230" height="24" as="geometry"/></mxCell><mxCell id="c10" value="connect to session hosts" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="707" y="204" width="200" height="24" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Windows 365&lt;/b&gt;&lt;br&gt;Software as a service (SaaS)&lt;br&gt;Shown with the recommended setup (note below)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa5b1;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="238" width="430" height="84" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Azure Virtual Desktop&lt;/b&gt;&lt;br&gt;Platform as a service (PaaS)&lt;br&gt;You build it in your own Azure subscription" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa5b1;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="238" width="430" height="84" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="490" y="254" width="36" height="36" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Microsoft manages&lt;/b&gt;&lt;br&gt;Cloud PCs and the Cloud PC infrastructure&lt;br&gt;The virtual network and routing&lt;br&gt;Its own Azure subscription and resource groups&lt;br&gt;The Intune service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4ec;strokeColor=#8fbf9b;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="332" width="430" height="134" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;You manage&lt;/b&gt;&lt;br&gt;Microsoft Entra ID&lt;br&gt;Azure DNS&lt;br&gt;Windows and your apps on the Cloud PC&lt;br&gt;Cloud PC security&lt;br&gt;Intune policies and settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#8fb0dc;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="476" width="430" height="158" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Different option: Azure network connection&lt;/b&gt;&lt;br&gt;Instead of the Microsoft-hosted network, you manage:&lt;br&gt;Your Azure subscription and resource groups&lt;br&gt;The virtual network, routing, VPN or ExpressRoute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fe;strokeColor=#8fb0dc;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="644" width="430" height="108" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Microsoft manages&lt;/b&gt;&lt;br&gt;The AVD service and its supporting&lt;br&gt;infrastructure, such as the gateway and broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4ec;strokeColor=#8fbf9b;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="332" width="430" height="134" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;You manage&lt;/b&gt;&lt;br&gt;Session host virtual machines and their disks&lt;br&gt;Images (your own, or from the Azure Gallery)&lt;br&gt;The virtual network&lt;br&gt;Identity: Microsoft Entra join or hybrid join&lt;br&gt;Profile storage with FSLogix&lt;br&gt;Host pools, desktops and apps you publish&lt;br&gt;Capacity and cost, for example autoscale&lt;br&gt;The Azure resources and their costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#8fb0dc;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="476" width="430" height="276" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Price model&lt;/b&gt;&lt;br&gt;Fixed monthly fee per licensed user&lt;br&gt;Flex licenses are pooled for the tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d9b45a;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="764" width="430" height="86" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Price model&lt;/b&gt;&lt;br&gt;Consumption-based, varies with use&lt;br&gt;Internal users also need an eligible license" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d9b45a;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="764" width="430" height="86" as="geometry"/></mxCell><mxCell id="c21" value="Windows 365 lists show the recommended setup: a Microsoft-hosted network, Microsoft Entra join" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="862" width="880" height="24" as="geometry"/></mxCell><mxCell id="c22" value="and gallery images with Windows Autopatch." style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="882" width="880" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>