<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="windows-365-disaster-recovery" name="windows-365-disaster-recovery"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="988" height="768" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="470" height="730" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;What protects a Cloud PC (Windows 365 Enterprise)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="34" width="430" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Cloud PC&lt;/b&gt;&lt;br&gt;Windows 365 Enterprise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="44" y="70" width="430" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="87.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Automated in-zone recovery&lt;/b&gt;&lt;br&gt;Host, power or networking failure in a zone&lt;br&gt;Moves to healthy compute in the same zone&lt;br&gt;RPO ~0. No admin action. User reconnects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fbf8e;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="150" width="430" height="118" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Point-in-time restore&lt;/b&gt;&lt;br&gt;Restores a Cloud PC to an earlier point&lt;br&gt;Changes made after that point are lost&lt;br&gt;An admin starts it. Users can too, if allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="298" width="430" height="118" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Cross region disaster recovery&lt;/b&gt;&lt;br&gt;For a regional outage. RPO &amp;lt; 4 hours&lt;br&gt;RTO &amp;lt; 4 hours (fewer than 50,000 DR-licensed Cloud PCs)&lt;br&gt;An admin activates it manually" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0a96b;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="446" width="430" height="118" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Disaster Recovery Plus&lt;/b&gt;&lt;br&gt;Capacity is reserved in the alternate region&lt;br&gt;RTO is less than 31 minutes&lt;br&gt;Users can self-activate if the setting is on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0a96b;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="44" y="594" width="430" height="118" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="514" y="24" width="462" height="730" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;What you do in a regional outage&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="534" y="34" width="422" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;1. Check Service health&lt;/b&gt;&lt;br&gt;Microsoft 365 admin center &amp;gt; Health &amp;gt; Service health&lt;br&gt;Look for incidents on Windows 365 or Azure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="534" y="70" width="422" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;2. If the admin center is not reachable&lt;/b&gt;&lt;br&gt;status.cloud.microsoft, azure.status.microsoft&lt;br&gt;@MSFT365Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="534" y="185" width="422" height="90" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="534" y="300" width="422" height="302" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="548" y="306" width="30" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Microsoft Intune admin center&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="594" y="308" width="300" height="24" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;3. Check the status report&lt;/b&gt;&lt;br&gt;Cloud PC optional business continuity and&lt;br&gt;disaster recovery status report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="550" y="355" width="390" height="85" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;4. Activate cross region DR&lt;/b&gt;&lt;br&gt;Devices &amp;gt; All devices &amp;gt; Bulk device actions&lt;br&gt;Device action: Optional disaster recovery&lt;br&gt;Action type: Activate cross region disaster recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0a96b;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="550" y="468" width="390" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;5. After Microsoft declares it over&lt;/b&gt;&lt;br&gt;Deactivate in Intune, or wait for automatic&lt;br&gt;failback (up to 7 days). Deactivating deletes&lt;br&gt;the temporary Cloud PC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0a96b;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="534" y="630" width="422" height="108" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="275" as="sourcePoint"/><mxPoint x="745" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="602" as="sourcePoint"/><mxPoint x="745" y="630" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>