mxCell><mxCell id="c29" value="users in the group" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="222" y="745" width="160" height="24" as="geometry"/></mxCell><mxCell id="c30" value="users in the group" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="562" y="745" width="150" height="24" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Microsoft Entra security group&lt;/b&gt;&lt;br&gt;Named in the provisioning policy. Users must be in it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="660" height="76" as="geometry"/></mxCell><mxCell id="c32" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="62" y="798" width="30" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>