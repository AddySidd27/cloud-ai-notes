<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="avd23" name="Session quality checks"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="610" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="948" height="598" as="geometry"/></mxCell><mxCell id="c2" value="A slow session: three places to check" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="260" y="14" width="440" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The network path, both directions" style="swimlane;startSize=26;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="520" height="130" as="geometry"/></mxCell><mxCell id="c4" value="Where to look" style="swimlane;startSize=26;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="900" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;User&amp;#x27;s device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;client and local network&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;imageAspect=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=14;fontColor=#1f2933;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="83" width="64" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Session host&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;virtual machine in Azure&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;imageAspect=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=14;fontColor=#1f2933;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="800" y="83" width="64" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Connection Information&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;on the client:&lt;br&gt;which transport is in use&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;imageAspect=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=14;fontColor=#1f2933;image=data:image/svg+xml,;" vertex="1" parent="c4"><mxGeometry x="82" y="38" width="56" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Connection network data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;Log Analytics, every 2 min:&lt;br&gt;bandwidth, round-trip time&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;imageAspect=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=14;fontColor=#1f2933;image=data:image/svg+xml,;" vertex="1" parent="c4"><mxGeometry x="312" y="38" width="56" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Connection graphics data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;Log Analytics (preview):&lt;br&gt;written only when quality drops&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;imageAspect=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=14;fontColor=#1f2933;image=data:image/svg+xml,;" vertex="1" parent="c4"><mxGeometry x="542" y="38" width="56" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;AVD Insights&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;round-trip time by gateway&lt;br&gt;region, input delay by host&lt;/font&gt;" style="shape=image;html=1;aspect=fixed;imageAspect=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=14;fontColor=#1f2933;image=data:image/svg+xml,;" vertex="1" parent="c4"><mxGeometry x="772" y="38" width="56" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;1. How long is it?&lt;/b&gt;&lt;br&gt;Round-trip time&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;distance, VPN, proxy, firewall&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e5;strokeColor=#f0b48a;fontSize=14;fontColor=#1f2933;" vertex="1" parent="c3"><mxGeometry x="10" y="40" width="240" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;2. How full is it?&lt;/b&gt;&lt;br&gt;Bandwidth, packet loss, jitter&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;video, large prints, shared links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e5;strokeColor=#f0b48a;fontSize=14;fontColor=#1f2933;" vertex="1" parent="c3"><mxGeometry x="270" y="40" width="240" height="76" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;3. How busy is the host?&lt;/b&gt;&lt;br&gt;CPU, memory, input delay&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5f6b7a&quot;&gt;size and storage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#8bcb9f;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="750" y="210" width="190" height="96" as="geometry"/></mxCell><mxCell id="c14" value="QoS and the throttle rate apply only to the RDP Shortpath for managed networks path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="180" y="536" width="600" height="38" as="geometry"/></mxCell><mxCell id="c15" value="Drawn by the author from Microsoft Learn pages, with Azure icons. Not an official Microsoft diagram." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="180" y="586" width="600" height="22" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;startArrow=classic;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" source="c5" target="c3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;startArrow=classic;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" source="c3" target="c6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=classic;strokeColor=#3c8d40;strokeWidth=1.5;" edge="1" source="c13" target="c6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>