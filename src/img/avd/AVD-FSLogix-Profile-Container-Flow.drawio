<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="AVD-FSLogix-Profile-Container-Flow" name="AVD-FSLogix-Profile-Container-Flow"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="988" height="688" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A profile container follows the user, not the machine&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Session host A (virtual machine)&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="420" height="205" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="28" height="28" as="geometry"/></mxCell><mxCell id="c5" value="At sign-in, FSLogix attaches the user&amp;#x27;s container" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="112" width="420" height="24" as="geometry"/></mxCell><mxCell id="c6" value="as a virtual disk. The profile appears at" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="134" width="420" height="24" as="geometry"/></mxCell><mxCell id="c7" value="C:\Users\username, so apps behave as if it were local." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="156" width="420" height="24" as="geometry"/></mxCell><mxCell id="c8" value="A few items are redirected to the local folder" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="178" width="420" height="24" as="geometry"/></mxCell><mxCell id="c9" value="C:\Users\local_username, which is deleted at sign-out." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="200" width="420" height="24" as="geometry"/></mxCell><mxCell id="c10" value="At sign-out the container is detached." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="222" width="420" height="24" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Session host B (virtual machine)&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="420" height="125" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="28" height="28" as="geometry"/></mxCell><mxCell id="c13" value="In a pooled host pool the next sign-in can land here." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="342" width="420" height="24" as="geometry"/></mxCell><mxCell id="c14" value="The same container is attached again." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="364" width="420" height="24" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;SMB file share&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f0;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="360" height="355" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="620" y="78" width="28" height="28" as="geometry"/></mxCell><mxCell id="c17" value="for example Azure Files" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="610" y="104" width="360" height="24" as="geometry"/></mxCell><mxCell id="c18" value="This is the storage provider. Its location" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="630" y="140" width="420" height="24" as="geometry"/></mxCell><mxCell id="c19" value="is set by VHDLocations." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="420" height="24" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;User 1 folder&lt;/b&gt;&lt;br&gt;profile container (VHDX file)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="196" width="320" height="58" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;User 2 folder&lt;/b&gt;&lt;br&gt;profile container (VHDX file)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="264" width="320" height="58" as="geometry"/></mxCell><mxCell id="c22" value="One container per user holds the whole profile," style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="420" height="24" as="geometry"/></mxCell><mxCell id="c23" value="including Microsoft 365 data in the" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="420" height="24" as="geometry"/></mxCell><mxCell id="c24" value="recommended single-container setup." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="630" y="380" width="420" height="24" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452" y="200" as="sourcePoint"/><mxPoint x="608" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;attach at sign-in&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#7a5bb5;" vertex="1" parent="1"><mxGeometry x="452" y="172" width="156" height="24" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="608" y="232" as="sourcePoint"/><mxPoint x="452" y="232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;detach at sign-out&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#7a5bb5;" vertex="1" parent="1"><mxGeometry x="452" y="238" width="156" height="24" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452" y="368" as="sourcePoint"/><mxPoint x="608" y="368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;attach same container&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3c9d5d;" vertex="1" parent="1"><mxGeometry x="452" y="340" width="156" height="24" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=1;arcSize=2;html=1;fillColor=#fff4e5;strokeColor=#c45a10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="940" height="225" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;If the container cannot be attached&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#c45a10;" vertex="1" parent="1"><mxGeometry x="48" y="462" width="500" height="24" as="geometry"/></mxCell><mxCell id="c33" value="Depending on the cause and settings, the user may get a temporary profile or be blocked from signing in. Common causes:" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="494" width="420" height="24" as="geometry"/></mxCell><mxCell id="c34" value="Permissions on the share deny access." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="70" y="526" width="600" height="24" as="geometry"/></mxCell><mxCell id="c35" value="The container is in use in another session." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="70" y="554" width="600" height="24" as="geometry"/></mxCell><mxCell id="c36" value="The share or the container is full." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="70" y="582" width="600" height="24" as="geometry"/></mxCell><mxCell id="c37" value="The session host cannot reach or resolve the share (network or DNS)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="600" height="24" as="geometry"/></mxCell><mxCell id="c38" value="The VHDLocations value is wrong or missing." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="70" y="638" width="600" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>