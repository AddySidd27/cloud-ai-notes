<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="avd25" name="Cloud Cache"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="612" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="988" height="600" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Cloud Cache: how data moves&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="150" y="14" width="700" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="64" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;User&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="14" y="220" width="96" height="24" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="182" as="sourcePoint"/><mxPoint x="176" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;1. Signs in&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="90" height="24" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="350" height="380" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="194" y="80" width="44" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Session host&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="246" y="90" width="200" height="24" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Proxy file&lt;/b&gt;&lt;br&gt;Profile_%username%.vhd&lt;br&gt;Windows sees it as the profile disk.&lt;br&gt;It uses no disk space itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="196" y="135" width="318" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Local cache&lt;/b&gt;&lt;br&gt;The real working copy, in&lt;br&gt;C:\ProgramData\FSLogix\Cache&lt;br&gt;3. The user works here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#8bcb9f;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="196" y="300" width="318" height="115" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="237" as="sourcePoint"/><mxPoint x="355" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;2. Reads and writes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="366" y="246" width="150" height="24" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;go to the cache&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="366" y="264" width="150" height="24" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="690" y="70" width="290" height="380" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Storage providers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="704" y="78" width="260" height="24" as="geometry"/></mxCell><mxCell id="c17" value="CCDLocations: up to 4, first = primary" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="704" y="100" width="260" height="24" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Provider 1 (first)&lt;/b&gt;&lt;br&gt;SMB file share or Azure page blob.&lt;br&gt;Used for reads. Gets every write." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f3eeff;strokeColor=#b9a6f0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="710" y="128" width="250" height="108" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Provider 2&lt;/b&gt;&lt;br&gt;SMB file share or Azure page blob.&lt;br&gt;Gets every write." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f3eeff;strokeColor=#b9a6f0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="710" y="252" width="250" height="108" as="geometry"/></mxCell><mxCell id="c20" value="Provider 3 and 4 (optional)&lt;br&gt;Each also gets every write" style="rounded=1;dashed=1;html=1;fillColor=#FAF8FF;strokeColor=#B9A6F0;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="710" y="378" width="250" height="52" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="708" y="170" as="sourcePoint"/><mxPoint x="516" y="335" as="targetPoint"/><Array as="points"><mxPoint x="610" y="170"/><mxPoint x="610" y="335"/></Array></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;4. Read missing data&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="536" y="104" width="150" height="24" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;(hydrate) from the&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="536" y="122" width="150" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;first healthy provider&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="536" y="140" width="150" height="24" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516" y="365" as="sourcePoint"/><mxPoint x="708" y="200" as="targetPoint"/><Array as="points"><mxPoint x="640" y="365"/><mxPoint x="640" y="200"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516" y="395" as="sourcePoint"/><mxPoint x="708" y="306" as="targetPoint"/><Array as="points"><mxPoint x="660" y="395"/><mxPoint x="660" y="306"/></Array></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;5. Write every change&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="536" y="400" width="150" height="22" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;(flush) to all providers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="536" y="418" width="150" height="22" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;in the background&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="536" y="436" width="150" height="22" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;5&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="672" y="176" width="20" height="24" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;5&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="676" y="282" width="20" height="24" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="450" height="96" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;6. At sign-out, if a provider is behind&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="476" width="420" height="24" as="geometry"/></mxCell><mxCell id="c34" value="Sign-out waits until the providers match." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="500" width="430" height="24" as="geometry"/></mxCell><mxCell id="c35" value="Limit: CcdUnregisterTimeout (default 0 = no limit)." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="44" y="521" width="430" height="24" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="470" height="96" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;If all providers are down&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="514" y="476" width="440" height="24" as="geometry"/></mxCell><mxCell id="c38" value="Work continues from the cache, up to SizeInMBs." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="514" y="500" width="450" height="24" as="geometry"/></mxCell><mxCell id="c39" value="Data not in the cache cannot be read: hang or crash." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="514" y="521" width="450" height="24" as="geometry"/></mxCell><mxCell id="c40" value="Proxy file = a stand-in that Windows mounts as the profile disk. The real data is in the local cache." style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="30" y="574" width="940" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>