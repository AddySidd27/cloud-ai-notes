<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="troubleshoot-host-pool-registration-failures" name="troubleshoot-host-pool-registration-failures"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1088" height="1128" as="geometry"/></mxCell><mxCell id="c2" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="70" y="38" width="40" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Host missing from the host pool,&lt;/b&gt;&lt;br&gt;or it never becomes Available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="130" y="34" width="400" height="56" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="92" as="sourcePoint"/><mxPoint x="330" y="132" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;Did the VM deployment&lt;br&gt;succeed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="134.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Read the deployment error&lt;/b&gt;&lt;br&gt;Deployment operations first, then the Activity log.&lt;br&gt;Match the error to the table in this article." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="132.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c7" value="Source: Troubleshoot host pool creation" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="204.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="180.0" as="sourcePoint"/><mxPoint x="638" y="180.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="156.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="226.0" as="sourcePoint"/><mxPoint x="330" y="256.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="230.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Is the host joined to&lt;br&gt;the domain? (AD hosts)&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="258.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Fix the domain join&lt;/b&gt;&lt;br&gt;Check the credentials, MFA on the join account,&lt;br&gt;permissions, and DNS or VNet peering." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="256.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c14" value="Source: Troubleshoot session host VM configuration" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="328.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="304.0" as="sourcePoint"/><mxPoint x="638" y="304.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="280.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="350.0" as="sourcePoint"/><mxPoint x="330" y="380.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="354.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Are the agent and boot&lt;br&gt;loader installed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="382.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Install the agent and boot loader&lt;/b&gt;&lt;br&gt;No ScriptLog.log means the DSC never ran.&lt;br&gt;Register with a valid registration key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="380.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c21" value="Source: Troubleshoot session host VM configuration" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="452.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="428.0" as="sourcePoint"/><mxPoint x="638" y="428.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="404.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="474.0" as="sourcePoint"/><mxPoint x="330" y="504.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="478.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Is the registration&lt;br&gt;token valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="506.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Replace the registration key&lt;/b&gt;&lt;br&gt;Event 3277 INVALID_REGISTRATION_TOKEN or&lt;br&gt;EXPIRED_MACHINE_TOKEN: new key, restart the boot loader." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="504.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c28" value="Source: Troubleshoot common Agent issues" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="576.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="552.0" as="sourcePoint"/><mxPoint x="638" y="552.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="528.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="598.0" as="sourcePoint"/><mxPoint x="330" y="628.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="602.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Is the VM name unique&lt;br&gt;in the host pool?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="630.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Remove the duplicate entry&lt;/b&gt;&lt;br&gt;NAME_ALREADY_REGISTERED: remove the old host from&lt;br&gt;the pool, then register a VM with a unique name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="628.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c35" value="Source: Troubleshoot common Agent issues" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="700.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="676.0" as="sourcePoint"/><mxPoint x="638" y="676.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="652.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="722.0" as="sourcePoint"/><mxPoint x="330" y="752.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="726.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Can the host reach&lt;br&gt;the broker on port 443?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="754.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Unblock the broker and required URLs&lt;/b&gt;&lt;br&gt;INVALID_FORM, 3703 or 3019: test /api/health,&lt;br&gt;run the URL tool, test port 443." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="752.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c42" value="Source: Troubleshoot common Agent issues" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="824.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="800.0" as="sourcePoint"/><mxPoint x="638" y="800.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="776.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="846.0" as="sourcePoint"/><mxPoint x="330" y="876.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="850.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Is the stack listening&lt;br&gt;(qwinsta shows Listen)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="170.0" y="878.0" width="320" height="92" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Repair the side-by-side stack&lt;/b&gt;&lt;br&gt;Reinstall the stack; check DisableRegistryTools." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="876.0" width="410" height="96" as="geometry"/></mxCell><mxCell id="c49" value="Source: Troubleshoot common Agent issues" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="948.0" width="410" height="24" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="924.0" as="sourcePoint"/><mxPoint x="638" y="924.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="496.0" y="900.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="970.0" as="sourcePoint"/><mxPoint x="330" y="1012.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="338" y="978.0" width="60" height="24" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Still not Available: uninstall, remove, re-register&lt;/b&gt;&lt;br&gt;Uninstall the four Remote Desktop components, remove the host from the pool, generate a new registration key,&lt;br&gt;then reinstall the agent and boot loader and restart the VM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="1014.0" width="900" height="100" as="geometry"/></mxCell><mxCell id="c55" value="Source: Troubleshoot common Agent issues" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="100" y="1090.0" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>