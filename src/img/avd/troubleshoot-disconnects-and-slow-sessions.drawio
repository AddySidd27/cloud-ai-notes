<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="troubleshoot-disconnects-and-slow-sessions" name="troubleshoot-disconnects-and-slow-sessions"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1125" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1088" height="1073" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Session drops, lags or is slow&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100.0" y="44" width="340" height="46" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="90" as="sourcePoint"/><mxPoint x="270" y="117.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="Does it affect one user&lt;br&gt;or many users?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#9bbbe0;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="90.0" y="119.0" width="360" height="98" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="168" as="sourcePoint"/><mxPoint x="518" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Many&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="454.0" y="144" width="62.0" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Check Azure status and Service Health first&lt;/b&gt;&lt;br&gt;Then group by gateway region, host and client in Insights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="129.0" width="539" height="78" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="219.0" as="sourcePoint"/><mxPoint x="270" y="257.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;One&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="278" y="221.0" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="Does it happen only&lt;br&gt;while signing in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#9bbbe0;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="90.0" y="259.0" width="360" height="98" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="308" as="sourcePoint"/><mxPoint x="518" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="454.0" y="284" width="62.0" height="24" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Slow sign-in: read the time to connect parts&lt;/b&gt;&lt;br&gt;Route, stack connected, logon (profile, policies, FSLogix), shell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="269.0" width="539" height="78" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="359.0" as="sourcePoint"/><mxPoint x="270" y="397.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="278" y="361.0" width="90" height="24" as="geometry"/></mxCell><mxCell id="c19" value="Is round-trip time high?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#9bbbe0;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="90.0" y="399.0" width="360" height="98" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="448" as="sourcePoint"/><mxPoint x="518" y="448" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="454.0" y="424" width="62.0" height="24" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Network path: move hosts closer, check the path&lt;/b&gt;&lt;br&gt;Firewall, ExpressRoute, proxy, SSL inspection, saturated link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="409.0" width="539" height="78" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="499.0" as="sourcePoint"/><mxPoint x="270" y="537.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="278" y="501.0" width="90" height="24" as="geometry"/></mxCell><mxCell id="c26" value="Is input delay, CPU or memory&lt;br&gt;high on the session host?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#9bbbe0;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="90.0" y="539.0" width="360" height="98" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="588" as="sourcePoint"/><mxPoint x="518" y="588" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="454.0" y="564" width="62.0" height="24" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Host is too busy: fewer sessions or a larger VM&lt;/b&gt;&lt;br&gt;Look at CPU, memory, disk and input delay for the same period" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="549.0" width="539" height="78" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="639.0" as="sourcePoint"/><mxPoint x="270" y="677.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="278" y="641.0" width="90" height="24" as="geometry"/></mxCell><mxCell id="c33" value="Is the session on TCP when&lt;br&gt;UDP was expected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#9bbbe0;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="90.0" y="679.0" width="360" height="98" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="728" as="sourcePoint"/><mxPoint x="518" y="728" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="454.0" y="704" width="62.0" height="24" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Run avdnettest.exe, then allow UDP&lt;/b&gt;&lt;br&gt;Avoid force tunnel, double NAT, TCP-based VPN, packet inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="689.0" width="539" height="78" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="779.0" as="sourcePoint"/><mxPoint x="270" y="817.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="278" y="781.0" width="90" height="24" as="geometry"/></mxCell><mxCell id="c40" value="Do errors name a Shortpath,&lt;br&gt;client or server disconnect?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#9bbbe0;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="90.0" y="819.0" width="360" height="98" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="868" as="sourcePoint"/><mxPoint x="518" y="868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="454.0" y="844" width="62.0" height="24" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Shortpath names: the UDP path dropped&lt;/b&gt;&lt;br&gt;Client or server disconnect names: usually a TCP reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="829.0" width="539" height="78" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="919.0" as="sourcePoint"/><mxPoint x="270" y="964" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="278" y="921.0" width="90" height="24" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Collect the CorrelationId, open a support request&lt;/b&gt;&lt;br&gt;ServiceError true: escalate with the CorrelationId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=16;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="967.0" width="460" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>