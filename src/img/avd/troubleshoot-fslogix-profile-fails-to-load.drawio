<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="troubleshoot-fslogix-profile-fails-to-load" name="troubleshoot-fslogix-profile-fails-to-load"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="852" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1088" height="840" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;FSLogix enabled and VHDLocations set?&lt;/b&gt;&lt;br&gt;Registry: Enabled = 1, location present" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="420" height="64" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Turn it on and set the location&lt;/b&gt;&lt;br&gt;Enabled = 1; VHDLocations or CCDLocations&lt;br&gt;Source: Old, temporary or local profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="30" width="430" height="84" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="72.0" as="sourcePoint"/><mxPoint x="618" y="72.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="474" y="48.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="106" as="sourcePoint"/><mxPoint x="260.0" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="268.0" y="112" width="50" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Profile log: Access is denied (error 5)?&lt;/b&gt;&lt;br&gt;[ERROR:00000005] on the LoadProfile line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="158" width="420" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Fix storage permissions&lt;/b&gt;&lt;br&gt;NTFS ACLs, share-level permissions, Azure RBAC&lt;br&gt;Source: Configure SMB storage permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="148" width="430" height="84" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="190.0" as="sourcePoint"/><mxPoint x="618" y="190.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="166.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="224" as="sourcePoint"/><mxPoint x="260.0" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="230" width="50" height="24" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Profile log: container locked (a7, error 33)?&lt;/b&gt;&lt;br&gt;Another session holds the container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="276" width="420" height="64" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Sign out the other session or choose the lock behavior&lt;/b&gt;&lt;br&gt;PreventLoginWithTempProfile or concurrent connections&lt;br&gt;Source: Old, temporary or local profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="266" width="430" height="84" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="308.0" as="sourcePoint"/><mxPoint x="618" y="308.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="284.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="342" as="sourcePoint"/><mxPoint x="260.0" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="348" width="50" height="24" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Can the host reach the share on SMB?&lt;/b&gt;&lt;br&gt;Test-NetConnection -CommonTCPPort SMB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="394" width="420" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Fix name resolution, network or firewall&lt;/b&gt;&lt;br&gt;Also check IPS and antivirus exclusions&lt;br&gt;Source: Container attach or detach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="384" width="430" height="84" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="426.0" as="sourcePoint"/><mxPoint x="618" y="426.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="474" y="402.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="460" as="sourcePoint"/><mxPoint x="260.0" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="268.0" y="466" width="50" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Is the container or the storage full?&lt;/b&gt;&lt;br&gt;Needs more than 200 MB free to attach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="420" height="64" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Raise SizeInMBs or add storage capacity&lt;/b&gt;&lt;br&gt;You can raise SizeInMBs but not lower it&lt;br&gt;Source: Container attach or detach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="502" width="430" height="84" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="544.0" as="sourcePoint"/><mxPoint x="618" y="544.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="520.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="578" as="sourcePoint"/><mxPoint x="260.0" y="628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="584" width="50" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Empty profile, but not a temporary one?&lt;/b&gt;&lt;br&gt;Folder under C:\Users has the normal name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="630" width="420" height="64" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Check for an old local profile or a changed name setting&lt;/b&gt;&lt;br&gt;DeleteLocalProfileWhenVHDShouldApply, folder-name settings&lt;br&gt;Source: Old, temporary or local profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="620" width="430" height="84" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="662.0" as="sourcePoint"/><mxPoint x="618" y="662.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="638.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="696" as="sourcePoint"/><mxPoint x="260.0" y="736" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="702" width="50" height="24" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Still failing: collect logs, open a support case&lt;/b&gt;&lt;br&gt;Use the FSLogix Support Tool to gather the logs&lt;br&gt;Source: Logging and diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="738" width="420" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>