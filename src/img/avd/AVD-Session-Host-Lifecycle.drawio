<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="AVD-Session-Host-Lifecycle" name="AVD-Session-Host-Lifecycle"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="775" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="988" height="763" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Registering and replacing session hosts&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#3b78c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="960" height="360" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Registering a session host (standard management)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#3b78c4;" vertex="1" parent="1"><mxGeometry x="38" y="52" width="600" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Host pool&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="205" height="150" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="45" y="96" width="28" height="28" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Registration token:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="47" y="130" width="420" height="24" as="geometry"/></mxCell><mxCell id="c8" value="authorizes hosts to join" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="47" y="147" width="420" height="24" as="geometry"/></mxCell><mxCell id="c9" value="the pool. Valid only for" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="47" y="164" width="420" height="24" as="geometry"/></mxCell><mxCell id="c10" value="the time set" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="47" y="181" width="420" height="24" as="geometry"/></mxCell><mxCell id="c11" value="(1 hour to 27 days)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="47" y="198" width="420" height="24" as="geometry"/></mxCell><mxCell id="c12" value="With a session host configuration the" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="38" y="255" width="270" height="24" as="geometry"/></mxCell><mxCell id="c13" value="service creates the hosts. You cannot" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="38" y="273" width="270" height="24" as="geometry"/></mxCell><mxCell id="c14" value="retrieve a registration token to add" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="38" y="291" width="270" height="24" as="geometry"/></mxCell><mxCell id="c15" value="hosts created outside it." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="38" y="309" width="270" height="24" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=2;html=1;fillColor=#eef7f0;strokeColor=#3c9d5d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="345" height="315" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="342" y="86" width="28" height="28" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Session host (virtual machine)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="378" y="90" width="280" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Remote Desktop Agent Boot Loader&lt;/b&gt;&lt;br&gt;Loads the agent. Opens the broker channel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="342" y="126" width="321" height="58" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Infrastructure Agent (RDAgent)&lt;/b&gt;&lt;br&gt;Takes the token at install. Runs health checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="342" y="192" width="321" height="58" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;SxS (side-by-side) Network Stack&lt;/b&gt;&lt;br&gt;A health check confirms it is listening." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="342" y="258" width="321" height="58" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Geneva Monitoring Agent&lt;/b&gt;&lt;br&gt;Sends monitoring data. Health checked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="342" y="324" width="321" height="58" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="242" y="222" as="sourcePoint"/><mxPoint x="340" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;token entered&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#7a5bb5;" vertex="1" parent="1"><mxGeometry x="242" y="174" width="95" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;at install&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#7a5bb5;" vertex="1" parent="1"><mxGeometry x="242" y="192" width="95" height="24" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="155" as="sourcePoint"/><mxPoint x="762" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;outbound TLS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#7a5bb5;" vertex="1" parent="1"><mxGeometry x="680" y="126" width="84" height="24" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Azure Virtual Desktop&lt;/b&gt;&lt;br&gt;service (broker)&lt;br&gt;The host is listed in the&lt;br&gt;host pool. Status may start&lt;br&gt;as Unavailable, then Available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="765" y="95" width="205" height="150" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="850.5" y="103" width="34" height="34" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;arcSize=2;html=1;fillColor=#fdf6ee;strokeColor=#c45a10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="960" height="335" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Replacing hosts with session host update (session host configuration only)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#c45a10;" vertex="1" parent="1"><mxGeometry x="38" y="428" width="800" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Edit the session host configuration&lt;/b&gt;&lt;br&gt;new image, size, settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="465" width="290" height="90" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Schedule the update&lt;/b&gt;&lt;br&gt;up to two weeks ahead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="355" y="465" width="290" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;One initial host first,&lt;/b&gt;&lt;br&gt;then the rest in batches&lt;br&gt;Steps 1 to 5 run for each batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="675" y="465" width="290" height="90" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="327" y="510" as="sourcePoint"/><mxPoint x="353" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="647" y="510" as="sourcePoint"/><mxPoint x="673" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="557" as="sourcePoint"/><mxPoint x="119" y="600" as="targetPoint"/><Array as="points"><mxPoint x="895" y="580"/><mxPoint x="119" y="580"/></Array></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;1 Notify users&lt;/b&gt;&lt;br&gt;Wait, then sign out&lt;br&gt;remaining users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="602" width="168" height="88" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205" y="646" as="sourcePoint"/><mxPoint x="233" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="&lt;b&gt;2 Drain mode on&lt;/b&gt;&lt;br&gt;Remove the old host&lt;br&gt;from the host pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="223" y="602" width="168" height="88" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="393" y="646" as="sourcePoint"/><mxPoint x="421" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;3 Create new hosts&lt;/b&gt;&lt;br&gt;from the updated&lt;br&gt;configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="411" y="602" width="168" height="88" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="581" y="646" as="sourcePoint"/><mxPoint x="609" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;4 Join the host pool&lt;/b&gt;&lt;br&gt;Drain mode off, ready&lt;br&gt;for connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="599" y="602" width="168" height="88" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="769" y="646" as="sourcePoint"/><mxPoint x="797" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;5 Original VMs&lt;/b&gt;&lt;br&gt;deleted or deallocated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="787" y="602" width="168" height="88" as="geometry"/></mxCell><mxCell id="c47" value="A host that fails to update is rolled back to the earlier configuration to keep capacity." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="38" y="705" width="420" height="24" as="geometry"/></mxCell><mxCell id="c48" value="Settings added by hand to the old hosts are not on the new ones: put them in the image or the configuration." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="38" y="725" width="420" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>