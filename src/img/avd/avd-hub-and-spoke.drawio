x="1" parent="1"><mxGeometry x="610" y="246" width="30" height="30" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Gateway&lt;/font&gt;&lt;/b&gt;&lt;br&gt;VPN or ExpressRoute&lt;br&gt;In GatewaySubnet, shared by the spokes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fb88f;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="600" y="360" width="280" height="100" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="610" y="366" width="30" height="30" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Shared DNS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Often used by the peered spokes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fb88f;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=24;" vertex="1" parent="1"><mxGeometry x="600" y="480" width="280" height="80" as="geometry"/></mxCell><mxCell id="c24" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="610" y="486" width="30" height="30" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;On-premises&lt;/font&gt;&lt;/b&gt;&lt;br&gt;network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1020" y="360" width="130" height="100" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.3030;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="Default route" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="402" y="248" width="180" height="24" as="geometry"/></mxCell><mxCell id="c28" value="over peering" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="402" y="266" width="180" height="24" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.8788;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Cross-premises" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="402" y="338" width="180" height="24" as="geometry"/></mxCell><mxCell id="c31" value="traffic" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="402" y="356" width="180" height="24" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;startArrow=classic;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="VPN or" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="880" y="356" width="140" height="24" as="geometry"/></mxCell><mxCell id="c34" value="ExpressRoute" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="140" height="24" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=none;html=1;startArrow=classic;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.9167;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7237;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;VNet peering&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="402" y="440" width="176" height="24" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="240" as="sourcePoint"/><mxPoint x="975" y="120" as="targetPoint"/><Array as="points"><mxPoint x="350" y="175"/><mxPoint x="975" y="175"/></Array></mxGeometry></mxCell><mxCell id="c38" value="Route: WindowsVirtualDesktop service tag, next hop Internet" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="380" y="148" width="590" height="24" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Peering settings between each spoke and the hub&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Hub link: Allow gateway transit.&lt;br&gt;Spoke link: Use the remote virtual network&amp;#x27;s gateway.&lt;br&gt;All links: Allow forwarded traffic.&lt;br&gt;Peering is nontransitive. Spokes reach each other through a route to the firewall, a peering between them, or a Virtual Network Manager connected group." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1120" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>