<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="avd-hub-and-spoke" name="avd-hub-and-spoke"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1168" height="768" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Users&lt;/font&gt;&lt;/b&gt;&lt;br&gt;On noncorporate networks,&lt;br&gt;connect to the service directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="48" y="30" width="332" height="90" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="36" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Azure Virtual Desktop service&lt;br&gt;(web, broker and gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="30" width="350" height="90" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="810" y="36" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="Over the internet, no VPN or ExpressRoute" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="400" y="44" width="380" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="370" height="300" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;AVD spoke virtual network&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="206" width="300" height="24" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f3faf5;strokeColor=#7fb88f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="320" height="380" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Hub virtual network&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="596" y="206" width="280" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Session host subnet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Session hosts in the host pool&lt;br&gt;Route table on the subnet:&lt;br&gt;Default route: Azure Firewall&lt;br&gt;Service tag WindowsVirtualDesktop:&lt;br&gt;next hop Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="48" y="240" width="334" height="165" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="246" width="30" height="30" as="geometry"