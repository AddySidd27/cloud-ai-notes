        <mxCell id="c7" value="Cloud service" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="86" y="88" width="360" height="22" as="geometry"/></mxCell>
        <mxCell id="c8" value="Microsoft Entra ID" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="130" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c9" value="Happens when the client:" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="154" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c10" value="- subscribes to the feed" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="178" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c11" value="- connects to the gateway" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="202" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c12" value="- sends diagnostics" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="226" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c13" value="Conditional Access and MFA" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="250" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="apply here. With SSO they also" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="274" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c15" value="apply at host sign-in, through" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="298" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c16" value="Windows Cloud Login." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="322" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2570c;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="355" y="70" width="290" height="328" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#c2570c;strokeColor=#c2570c;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="369" y="84" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c19" value="2" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="202.0" y="87" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c20" value="Remote session" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="411" y="88" width="360" height="22" as="geometry"/></mxCell>
        <mxCell id="c21" value="Sign-in to the session host" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="371" y="130" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c22" value="With SSO: the Entra token is" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="154" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c23" value="used, with no second prompt." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="178" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c24" value="Without SSO: a prompt on" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="202" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c25" value="every connection, unless" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="226" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c26" value="credentials are saved." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="250" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c27" value="Smart card and Windows Hello for" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="274" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="Business use Kerberos; they need" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="298" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c29" value="a domain controller in view, or" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="322" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c30" value="a KDC proxy." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="371" y="346" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c8d40;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="290" height="328" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#3c8d40;strokeColor=#3c8d40;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="694" y="84" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c33" value="3" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="527.0" y="87" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c34" value="In-session" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="736" y="88" width="360" height="22" as="geometry"/></mxCell>
        <mxCell id="c35" value="Apps and sites in the desktop" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="696" y="130" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c36" value="Passwordless: WebAuthn is" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="696" y="154" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c37" value="redirected to the local PC." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="696" y="178" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c38" value="Smart card: drivers on the" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="696" y="202" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c39" value="session host, plus smart" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="696" y="226" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c40" value="card redirection." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="696" y="250" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c41" value="" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#5f6b7a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="234" as="sourcePoint"/><mxPoint x="355" y="234" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c42" value="" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#5f6b7a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="234" as="sourcePoint"/><mxPoint x="680" y="234" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c43" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef6ee;strokeColor=#3c8d40;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="412" width="940" height="214" as="geometry"/></mxCell>
        <mxCell id="c44" value="To turn on single sign-on (the five documented tasks, in order)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="424" width="360" height="22" as="geometry"/></mxCell>
        <mxCell id="c45" value="1.  Allow Microsoft Entra authentication for RDP (the Windows Cloud Login application)." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="458" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c46" value="2.  Hide the consent prompt by listing session host device groups." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="485" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c47" value="3.  Create a Kerberos server object if Active Directory is part of the environment." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c48" value="4.  Review your Conditional Access policies." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="539" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c49" value="5.  Set the host pool: Microsoft Entra single sign-on, or enablerdsaadauth set to 1." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c50" value="Hosts must be Microsoft Entra joined or hybrid joined for this to work." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="596" width="360" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
