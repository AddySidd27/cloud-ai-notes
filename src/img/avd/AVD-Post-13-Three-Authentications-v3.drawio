        <mxCell id="c3" value="Three separate authentications on the way to a desktop" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320.0" y="16" width="360" height="26" as="geometry"/></mxCell>
