ft;verticalAlign=middle;fontSize=15;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="240" y="249" width="260" height="24" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#9bbbe0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="880" height="255" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Pooled host pool schedule: four phases, repeated on the days you pick&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="306" width="800" height="24" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Ramp-up&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Load balancing algorithm&lt;br&gt;Minimum % of hosts&lt;br&gt;Capacity threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="47" y="340" width="198" height="160" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Peak hours&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Load balancing algorithm&lt;br&gt;Capacity threshold&lt;br&gt;(from ramp-up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="263" y="340" width="198" height="160" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Ramp-down&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Load balancing algorithm&lt;br&gt;Minimum % of hosts&lt;br&gt;Capacity threshold&lt;br&gt;Force logoff of users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="479" y="340" width="198" height="160" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Off-peak hours&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Load balancing algorithm&lt;br&gt;Capacity threshold&lt;br&gt;(from ramp-down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="695" y="340" width="198" height="160" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794" y="500" as="sourcePoint"/><mxPoint x="146" y="500" as="targetPoint"/><Array as="points"><mxPoint x="794" y="520"/><mxPoint x="146" y="520"/></Array></mxGeometry></mxCell><mxCell id="c25" value="Next scheduled day: ramp-up starts again" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="257" y="524" width="400" height="24" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f3faf5;strokeColor=#7fb88f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="575" width="880" height="245" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Personal host pool schedule: the same four phases&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="48" y="581" width="800" height="24" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Ramp-up&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Start VM on Connect&lt;br&gt;VMs to start&lt;br&gt;Disconnect action&lt;br&gt;Sign out action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fb88f;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="47" y="615" width="198" height="165" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Peak hours&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Start VM on Connect&lt;br&gt;Disconnect action&lt;br&gt;Sign out action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fb88f;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="263" y="615" width="198" height="165" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Ramp-down&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Start VM on Connect&lt;br&gt;Disconnect action&lt;br&gt;Sign out action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fb88f;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="479" y="615" width="198" height="165" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Off-peak hours&lt;/b&gt;&lt;br&gt;Start time&lt;br&gt;Start VM on Connect&lt;br&gt;Disconnect action&lt;br&gt;Sign out action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7fb88f;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="695" y="615" width="198" height="165" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.000