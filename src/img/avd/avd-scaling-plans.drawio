<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="avd-scaling-plans" name="avd-scaling-plans"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="928" height="1078" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Scaling plan&lt;/b&gt;&lt;br&gt;Time zone, host pool type, exclusion tag&lt;br&gt;One or more schedules&lt;br&gt;One plan can cover many host pools&lt;br&gt;Takes effect when you enable it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="390" height="140" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Host pool&lt;/b&gt;&lt;br&gt;Same host pool type as the plan&lt;br&gt;One scaling plan per host pool&lt;br&gt;Pooled: set your own max session limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bbbe0;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="390" height="140" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="530" y="38" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;exitX=1.0000;exitY=0.4643;exitDx=0;exitDy=0;entryX=0.0000;