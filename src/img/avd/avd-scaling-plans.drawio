><mxCell id="c39" value="&lt;b&gt;Exclusion tag&lt;/b&gt;&lt;br&gt;Autoscale leaves tagged&lt;br&gt;hosts alone. They still&lt;br&gt;count in the minimum.&lt;br&gt;Applies to: session hosts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="407" y="880" width="230" height="165" as="geometry"/></mxCell><mxCell id="c40" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="417" y="888" width="28" height="28" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Start VM on Connect&lt;/b&gt;&lt;br&gt;Host pool setting, Yes or No&lt;br&gt;Personal schedules also set&lt;br&gt;it in each phase&lt;br&gt;Pooled: starts a VM at most&lt;br&gt;every five minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;fontSize=15;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="657" y="880" width="236" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>