        <mxCell id="c246" value="Customer network" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320.0" y="1665" width="360" height="19" as="geometry"/></mxCell>
        <mxCell id="c247" value="Inbound: connection weight or AS path prepending" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="1665" width="360" height="19" as="geometry"/></mxCell>
        <mxCell id="c248" value="Outbound: local preference" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="970" y="1665" width="360" height="19" as="geometry"/></mxCell>
        <mxCell id="c249" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c8d40;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="15" y="1704" width="970" height="74" as="geometry"/></mxCell>
        <mxCell id="c250" value="Panels D and E are two separate options from the same Learn page, not one design. Learn says to use peering for two regions" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="1711" width="360" height="19" as="geometry"/></mxCell>
        <mxCell id="c251" value="and to prefer shared ExpressRoute circuits for more than two. In E, hubs have no peering and spokes in other regions are reached by BGP routes." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="1731" width="360" height="19" as="geometry"/></mxCell>
        <mxCell id="c252" value="Each panel is only what its own Learn page draws. Virtual WAN is a separate topology. Check the cited pages before copying any panel." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="1751" width="360" height="19" as="geometry"/></mxCell>
