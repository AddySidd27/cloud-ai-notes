<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="avd24" name="Session host VM size"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="948" height="608" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;From workload to a session host VM: four steps&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="130" y="14" width="700" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="180" height="300" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="88" y="84" width="64" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1. Know the workload&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="156" width="180" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Light, medium, heavy" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="184" width="180" height="24" as="geometry"/></mxCell><mxCell id="c7" value="or power." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="180" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Single-session:" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="244" width="180" height="24" as="geometry"/></mxCell><mxCell id="c9" value="one user on each VM." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="264" width="180" height="24" as="geometry"/></mxCell><mxCell id="c10" value="Multi-session:" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="304" width="180" height="24" as="geometry"/></mxCell><mxCell id="c11" value="many users on each VM." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="324" width="180" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212" y="220" as="sourcePoint"/><mxPoint x="248" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="420" height="300" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="266" y="80" width="44" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;2. Choose the VM: four choices&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="318" y="90" width="330" height="24" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Size&lt;/b&gt;&lt;br&gt;How many vCPUs and how&lt;br&gt;much memory. The number&lt;br&gt;in the name is the vCPUs&lt;br&gt;(D16ds_v5 = 16 vCPUs)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="266" y="134" width="190" height="108" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;GPU (optional)&lt;/b&gt;&lt;br&gt;Only for graphics apps or&lt;br&gt;very high-resolution&lt;br&gt;screens. Needs an N size&lt;br&gt;and a driver from Azure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="472" y="134" width="190" height="108" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;OS disk&lt;/b&gt;&lt;br&gt;The disk Windows runs on.&lt;br&gt;Managed disk (normal), or&lt;br&gt;ephemeral = local VM&lt;br&gt;storage (check status)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="266" y="252" width="190" height="108" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Security type&lt;/b&gt;&lt;br&gt;Standard, Trusted launch&lt;br&gt;or Confidential. Trusted&lt;br&gt;launch needs a&lt;br&gt;Generation 2 VM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#9bbbe0;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="472" y="252" width="190" height="108" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="220" as="sourcePoint"/><mxPoint x="708" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="220" height="300" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="722" y="80" width="40" height="40" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;3. Azure checks,&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="768" y="84" width="160" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;then builds the VM&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="768" y="102" width="160" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Quota&lt;/b&gt;&lt;br&gt;How many vCPUs you may use.&lt;br&gt;Counted per region and per&lt;br&gt;VM family." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#b9a6f0;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="722" y="134" width="196" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Capacity&lt;/b&gt;&lt;br&gt;Different from quota. You&lt;br&gt;can have quota and still&lt;br&gt;find no free machines of&lt;br&gt;that size in the region." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#b9a6f0;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="722" y="222" width="196" height="98" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Automatic when you click Create.&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="722" y="330" width="196" height="24" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Fail&lt;/b&gt;&lt;br&gt;Change size, zone&lt;br&gt;or region, or request&lt;br&gt;more quota." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e5;strokeColor=#f0b48a;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="626" y="392" width="164" height="80" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Pass&lt;/b&gt;&lt;br&gt;Quota and capacity&lt;br&gt;are OK. Azure creates&lt;br&gt;the VM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#8bcb9f;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="798" y="392" width="132" height="80" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="372" as="sourcePoint"/><mxPoint x="730" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="372" as="sourcePoint"/><mxPoint x="864" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="626" y="428" as="sourcePoint"/><mxPoint x="470" y="372" as="targetPoint"/><Array as="points"><mxPoint x="470" y="428"/></Array></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Go back to step 2&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="480" y="402" width="140" height="24" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="472" as="sourcePoint"/><mxPoint x="864" y="488" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c35" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="900" height="92" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;4. After it runs: measure, tune and save money&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="496" width="700" height="24" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;AVD Insights&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="280" height="24" as="geometry"/></mxCell><mxCell id="c38" value="watch CPU, memory, delay; resize if needed" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="40" y="546" width="280" height="24" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Autoscale&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="340" y="524" width="280" height="24" as="geometry"/></mxCell><mxCell id="c40" value="starts and stops hosts" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="340" y="546" width="280" height="24" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Savings plans, reserved instances&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="640" y="524" width="280" height="24" as="geometry"/></mxCell><mxCell id="c42" value="lower the price if you commit for a set time" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="640" y="546" width="280" height="24" as="geometry"/></mxCell><mxCell id="c43" value="Drawn by the author from Microsoft Learn pages, with Azure icons. Not an official Microsoft diagram." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="180" y="592" width="600" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>