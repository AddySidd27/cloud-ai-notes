<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="AVD-Session-Host-VM-Size" name="AVD-Session-Host-VM-Size"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="948" height="648" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;From workload to a session host VM: four steps&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="960" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f7f8fa;strokeColor=#b4bcc7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="185" height="325" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="92" y="70" width="50" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1. Know the workload&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="128" width="185" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Light, medium, heavy" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="185" height="24" as="geometry"/></mxCell><mxCell id="c7" value="or power." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="184" width="185" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="203" width="185" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Single-session:" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="222" width="185" height="24" as="geometry"/></mxCell><mxCell id="c10" value="one user on each VM." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="241" width="185" height="24" as="geometry"/></mxCell><mxCell id="c11" value="" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="185" height="24" as="geometry"/></mxCell><mxCell id="c12" value="Multi-session:" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="279" width="185" height="24" as="geometry"/></mxCell><mxCell id="c13" value="many users on each VM." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="298" width="185" height="24" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f7f8fa;strokeColor=#b4bcc7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="420" height="325" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="262" y="66" width="30" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;2. Choose the VM: four choices&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="350" height="24" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Size&lt;/b&gt;&lt;br&gt;How many vCPUs and how&lt;br&gt;much memory. The number&lt;br&gt;in the name is the vCPU&lt;br&gt;count: D16ds_v5 = 16 vCPUs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="264" y="105" width="192" height="130" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;GPU (optional)&lt;/b&gt;&lt;br&gt;Only for graphics apps or&lt;br&gt;very high-resolution&lt;br&gt;screens. Needs an N size&lt;br&gt;and a driver from Azure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="464" y="105" width="192" height="130" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;OS disk&lt;/b&gt;&lt;br&gt;The disk Windows runs on.&lt;br&gt;Managed disk (the usual&lt;br&gt;choice), or ephemeral =&lt;br&gt;local VM storage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="264" y="245" width="192" height="130" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Security type&lt;/b&gt;&lt;br&gt;Standard, Trusted launch&lt;br&gt;or Confidential. Trusted&lt;br&gt;launch needs a&lt;br&gt;Generation 2 VM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="464" y="245" width="192" height="130" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f9f7fd;strokeColor=#7a5bb5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="60" width="225" height="325" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="722" y="66" width="30" height="30" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;3. Quota and capacity&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="756" y="66" width="175" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;can stop a deployment&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="756" y="84" width="175" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Quota&lt;/b&gt;&lt;br&gt;vCPUs you may use, counted&lt;br&gt;per region and per VM&lt;br&gt;family. Over quota: no deploy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eefb;strokeColor=#7a5bb5;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="722" y="115" width="201" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Capacity&lt;/b&gt;&lt;br&gt;Different from quota. You&lt;br&gt;can have quota and still&lt;br&gt;find no free machines of&lt;br&gt;that size in the region." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eefb;strokeColor=#7a5bb5;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="722" y="225" width="201" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Check both before you deploy.&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="722" y="350" width="201" height="24" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="217" y="222" as="sourcePoint"/><mxPoint x="248" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="222" as="sourcePoint"/><mxPoint x="708" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Fail&lt;/b&gt;&lt;br&gt;The deployment fails.&lt;br&gt;Change size, zone or&lt;br&gt;region, or request quota." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#c45a10;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="425" width="160" height="95" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Pass&lt;/b&gt;&lt;br&gt;Quota and capacity&lt;br&gt;are both enough.&lt;br&gt;The VM is created." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f0;strokeColor=#3c9d5d;fontSize=13;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="775" y="425" width="160" height="95" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="387" as="sourcePoint"/><mxPoint x="680" y="423" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="387" as="sourcePoint"/><mxPoint x="855" y="423" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598" y="472" as="sourcePoint"/><mxPoint x="460" y="387" as="targetPoint"/><Array as="points"><mxPoint x="460" y="472"/></Array></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Go back to step 2&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="470" y="444" width="130" height="24" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="522" as="sourcePoint"/><mxPoint x="855" y="543" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f7f8fa;strokeColor=#b4bcc7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="900" height="100" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;4. After it runs: measure, tune and save money&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="46" y="551" width="700" height="24" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="177" y="574" width="26" height="26" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;AVD Insights&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="45" y="603" width="290" height="24" as="geometry"/></mxCell><mxCell id="c41" value="watch CPU, memory, delay; resize if needed" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="45" y="621" width="290" height="24" as="geometry"/></mxCell><mxCell id="c42" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="467" y="574" width="26" height="26" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Autoscale&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="335" y="603" width="290" height="24" as="geometry"/></mxCell><mxCell id="c44" value="starts and stops hosts" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="335" y="621" width="290" height="24" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="757" y="574" width="26" height="26" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Savings plans, reserved instances&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="625" y="603" width="290" height="24" as="geometry"/></mxCell><mxCell id="c47" value="lower the price if you commit for a set time" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="625" y="621" width="290" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>