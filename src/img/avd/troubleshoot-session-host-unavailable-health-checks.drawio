<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="troubleshoot-session-host-unavailable-health-checks" name="troubleshoot-session-host-unavailable-health-checks"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="734" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="1088" height="722" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Is the VM running?&lt;/b&gt;&lt;br&gt;Power state in the Azure portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="420" height="64" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Start the VM and read the status again&lt;/b&gt;&lt;br&gt;Unavailable is expected while it is off&lt;br&gt;Source: Session host statuses and health checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="30" width="430" height="84" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="72.0" as="sourcePoint"/><mxPoint x="618" y="72.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="474" y="48.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="106" as="sourcePoint"/><mxPoint x="260.0" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="268.0" y="112" width="50" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Status is Needs Assistance?&lt;/b&gt;&lt;br&gt;URL, IMDS or Geneva check failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="158" width="420" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Unblock URLs and 169.254.169.254; fix the Geneva agent&lt;/b&gt;&lt;br&gt;Users can still connect&lt;br&gt;Source: Troubleshoot agent issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="148" width="430" height="84" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="190.0" as="sourcePoint"/><mxPoint x="618" y="190.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="166.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="224" as="sourcePoint"/><mxPoint x="260.0" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="230" width="50" height="24" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Unavailable: domain, trust or stack check failed?&lt;/b&gt;&lt;br&gt;Open the host under Session hosts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="276" width="420" height="64" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Join the domain or fix trust; restart; repair the stack&lt;/b&gt;&lt;br&gt;Check qwinsta: rdp-tcp and rdp-sxs say Listen&lt;br&gt;Source: Statuses and health checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="266" width="430" height="84" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="308.0" as="sourcePoint"/><mxPoint x="618" y="308.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="284.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="342" as="sourcePoint"/><mxPoint x="260.0" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="348" width="50" height="24" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Agent errors in the Application log?&lt;/b&gt;&lt;br&gt;Events 3277, 3703, 3019, 3389" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="394" width="420" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Match the event to its fix&lt;/b&gt;&lt;br&gt;URLs, broker address, installer, .NET Framework&lt;br&gt;Source: Troubleshoot agent issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="384" width="430" height="84" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="426.0" as="sourcePoint"/><mxPoint x="618" y="426.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="402.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="460" as="sourcePoint"/><mxPoint x="260.0" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="466" width="50" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Stuck in Upgrading or Upgrade Failed?&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#5b8fc9;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="420" height="64" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Reinstall the SxS stack, then the agent&lt;/b&gt;&lt;br&gt;Then re-register if the stack still does not listen&lt;br&gt;Source: Troubleshoot agent issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="502" width="430" height="84" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="544.0" as="sourcePoint"/><mxPoint x="618" y="544.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Yes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c7a50;" vertex="1" parent="1"><mxGeometry x="474" y="520.0" width="142" height="24" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="578" as="sourcePoint"/><mxPoint x="260.0" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;No&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#b02a2a;" vertex="1" parent="1"><mxGeometry x="268.0" y="584" width="50" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Still failing: reinstall, re-register, then open a case&lt;/b&gt;&lt;br&gt;New registration key; include the agent events&lt;br&gt;Source: Troubleshoot agent issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b866;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="420" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>