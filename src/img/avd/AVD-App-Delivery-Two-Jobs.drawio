<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="AVD-App-Delivery-Two-Jobs" name="AVD-App-Delivery-Two-Jobs"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6" y="6" width="988" height="868" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Two jobs: get the application onto session hosts, and decide what users see&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f4f8fd;strokeColor=#3b78c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="50" width="570" height="437" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Job 1: get the application onto the session hosts&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#3b78c4;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="540" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;In the image&lt;/b&gt;&lt;br&gt;The application is installed in the image, so every session host&lt;br&gt;built from that image has it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="540" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Installed with Intune&lt;/b&gt;&lt;br&gt;On Windows Enterprise multi-session session hosts: system context,&lt;br&gt;targeted to devices, Required or Uninstall intent.&lt;br&gt;Not the Available intent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="540" height="92" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="48" y="175" width="26" height="26" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;With App Attach&lt;/b&gt;&lt;br&gt;The application is not installed on the session host or in the image.&lt;br&gt;The application package is assigned to the host pool and to users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b78c4;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="540" height="204" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;SMB file share&lt;/b&gt;&lt;br&gt;Azure Files is recommended." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b78c4;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="58" y="346" width="500" height="120" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="66" y="350" width="28" height="28" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Application package&lt;/b&gt;&lt;br&gt;Disk image or App-V package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b4bcc7;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="78" y="402" width="460" height="54" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=2;html=1;fillColor=#eef7f0;strokeColor=#3c9d5d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="60" width="345" height="380" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="642" y="66" width="28" height="28" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Host pool&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="680" y="72" width="200" height="24" as="geometry"/></mxCell><mxCell id="c15" value="In a pooled host pool, several users can" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="648" y="112" width="420" height="24" as="geometry"/></mxCell><mxCell id="c16" value="be on one session host." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="648" y="132" width="420" height="24" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Session hosts&lt;/b&gt;&lt;br&gt;(virtual machines)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c9d5d;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="648" y="330" width="310" height="90" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="656" y="336" width="26" height="26" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="125" as="sourcePoint"/><mxPoint x="628" y="125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="215" as="sourcePoint"/><mxPoint x="628" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="300" as="sourcePoint"/><mxPoint x="628" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="376" as="sourcePoint"/><mxPoint x="560" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Job 2: decide what users see&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#c45a10;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="300" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;See their desktop or&lt;br&gt;RemoteApp applications&lt;br&gt;in Windows App." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eefb;strokeColor=#7a5bb5;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=47;" vertex="1" parent="1"><mxGeometry x="35" y="535" width="180" height="135" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="108" y="543" width="34" height="34" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=2;html=1;fillColor=#fff4e5;strokeColor=#c45a10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="325" y="515" width="650" height="175" as="geometry"/></mxCell><mxCell id="c27" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="337" y="521" width="28" height="28" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Workspace&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="373" y="525" width="200" height="24" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Application group&lt;/b&gt;&lt;br&gt;A desktop application group gives the full desktop. A RemoteApp application group&lt;br&gt;gives individual applications. An application group is assigned to one host pool,&lt;br&gt;and users are assigned to it. App Attach is the exception: the package is also&lt;br&gt;assigned to users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c45a10;fontSize=14;fontColor=#1f2933;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="345" y="560" width="610" height="120" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="353" y="564" width="26" height="26" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="217" y="610" as="sourcePoint"/><mxPoint x="343" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;assigned&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="232" y="584" width="96" height="24" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="558" as="sourcePoint"/><mxPoint x="800" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="assigned&lt;br&gt;one host pool" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="812" y="456" width="150" height="48" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f5f6f8;strokeColor=#b4bcc7;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="25" y="705" width="950" height="66" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;App Attach and the application groups&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="711" width="500" height="24" as="geometry"/></mxCell><mxCell id="c37" value="In a desktop session, assign the package to the host pool and to users. There is no step in the desktop application group." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="731" width="420" height="24" as="geometry"/></mxCell><mxCell id="c38" value="As a RemoteApp, also add the application to a RemoteApp application group." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="749" width="420" height="24" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#b4bcc7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="788" width="950" height="76" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;How to read the arrows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="794" width="300" height="24" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="825" as="sourcePoint"/><mxPoint x="95" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="Solid arrow: the tail delivers to," style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="105" y="813" width="420" height="24" as="geometry"/></mxCell><mxCell id="c43" value="or is assigned to, the head." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="105" y="831" width="420" height="24" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#5f6b7a;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="825" as="sourcePoint"/><mxPoint x="435" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="Dashed arrow: the tail reads from" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="445" y="813" width="420" height="24" as="geometry"/></mxCell><mxCell id="c46" value="the head." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="445" y="831" width="420" height="24" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#b4bcc7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="705" y="812" width="50" height="26" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=2;html=1;fillColor=#ffffff;strokeColor=#b4bcc7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="713" y="818" width="34" height="14" as="geometry"/></mxCell><mxCell id="c49" value="Box inside a box: the outer box" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="765" y="813" width="420" height="24" as="geometry"/></mxCell><mxCell id="c50" value="holds the inner one." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="765" y="831" width="420" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>