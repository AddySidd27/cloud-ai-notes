        <mxCell id="c27" value="Azure Virtual Desktop Hybrid, or" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570.0" y="261" width="360" height="20" as="geometry"/></mxCell>
