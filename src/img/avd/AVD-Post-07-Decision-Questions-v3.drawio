        <mxCell id="c16" value="with the app installed" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="570.0" y="153" width="360" height="20" as="geometry"/></mxCell>
