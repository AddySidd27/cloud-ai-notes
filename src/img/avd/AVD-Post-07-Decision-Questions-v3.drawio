        <mxCell id="c58" value="Azure Virtual Desktop in Azure: pooled or personal hosts, your own images, autoscale" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320.0" y="691" width="360" height="21" as="geometry"/></mxCell>
