        <mxCell id="c9" value="Do users need Windows desktops" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="84" y="119" width="360" height="21" as="geometry"/></mxCell>
