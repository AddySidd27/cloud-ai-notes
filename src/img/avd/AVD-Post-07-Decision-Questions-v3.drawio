        <mxCell id="c34" value="3" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-125.0" y="436" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c35" value="Do you need a platform" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="84" y="423" width="360" height="21" as="geometry"/></mxCell>
        <mxCell id="c36" value="from Citrix or Omnissa?" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="84" y="445" width="360" height="21" as="geometry"/></mxCell>
