        <mxCell id="c13" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b42318;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="92" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="c14" value="Another approach may be simpler," style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570.0" y="109" width="360" height="20" as="geometry"/></mxCell>
