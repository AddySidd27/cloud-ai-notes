        <mxCell id="c56" value="No" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="262" y="654" width="360" height="20" as="geometry"/></mxCell>
