        <mxCell id="c18" value="Otherwise, continue" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="262" y="210" width="360" height="20" as="geometry"/></mxCell>
