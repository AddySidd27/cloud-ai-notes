        <mxCell id="c38" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#6b4fa0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315.0" y="418" width="360" height="20" as="geometry"/></mxCell>
