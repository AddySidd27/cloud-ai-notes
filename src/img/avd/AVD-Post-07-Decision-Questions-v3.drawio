        <mxCell id="c47" value="Is one dedicated Cloud PC per user," style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="84" y="575" width="360" height="21" as="geometry"/></mxCell>
        <mxCell id="c48" value="run by Microsoft, enough?" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="84" y="597" width="360" height="21" as="geometry"/></mxCell>
        <mxCell id="c49" value="" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#3c8d40;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="598" as="sourcePoint"/><mxPoint x="520" y="598" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c50" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#3c8d40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315.0" y="570" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="c51" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3c8d40;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="548" width="440" height="100" as="geometry"/></mxCell>
