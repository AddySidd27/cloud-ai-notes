---
permalink: "/sitemap.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and p.url != "/404.html" and p.url != "/robots.txt" and p.url != "/sitemap.xml" and p.url != "/feed.xml" and p.url != "/search.json" %}
  <url><loc>{{ p.url | absUrl(site.url) }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
